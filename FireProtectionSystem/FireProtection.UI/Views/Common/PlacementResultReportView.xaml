<UserControl x:Class="FireProtection.UI.Views.Common.PlacementResultReportView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:local="clr-namespace:FireProtection.UI.Views.Common"
             mc:Ignorable="d"
             d:DesignHeight="600" d:DesignWidth="900"
             Background="Transparent"
             FontFamily="Segoe UI">

    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/FireProtection.UI;component/Themes/Colors.xaml"/>
                <ResourceDictionary Source="/FireProtection.UI;component/Themes/Styles.xaml"/>
            </ResourceDictionary.MergedDictionaries>

            <Style TargetType="Border" x:Key="StatusCardBorder">
                <Setter Property="CornerRadius" Value="6"/>
                <Setter Property="Padding" Value="16,12"/>
                <Setter Property="Margin" Value="0,0,12,0"/>
                <Setter Property="Background" Value="{StaticResource CardBrush}"/>
                <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}"/>
                <Setter Property="BorderThickness" Value="1"/>
            </Style>

            <Style TargetType="TextBlock" x:Key="StatusValue">
                <Setter Property="FontSize" Value="22"/>
                <Setter Property="FontWeight" Value="Bold"/>
                <Setter Property="VerticalAlignment" Value="Center"/>
            </Style>

            <Style TargetType="TextBlock" x:Key="StatusLabel">
                <Setter Property="FontSize" Value="11"/>
                <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}"/>
                <Setter Property="VerticalAlignment" Value="Center"/>
                <Setter Property="Margin" Value="0,4,0,0"/>
            </Style>
        </ResourceDictionary>
    </UserControl.Resources>

    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="12"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="12"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <Border Grid.Row="0" Style="{StaticResource CardBorder}">
            <Grid Margin="16,12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="{Binding ReportTitle}" Style="{StaticResource EyebrowText}"/>
                        <Border Background="{StaticResource CardBrush}" BorderBrush="{StaticResource BorderBrush}"
                                BorderThickness="1" CornerRadius="4" Padding="8,2" Margin="12,0,0,0" VerticalAlignment="Center">
                            <TextBlock Text="{Binding OverallStatusText}" FontSize="11" FontWeight="Bold"
                                       Foreground="{StaticResource TextPrimaryBrush}"/>
                        </Border>
                    </StackPanel>
                    <TextBlock Text="{Binding Summary}" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}"
                               Margin="0,4,0,0" TextWrapping="Wrap"/>
                    <TextBlock Text="{Binding RulesLine}" FontSize="11" Margin="0,2,0,0" TextWrapping="Wrap"
                               Foreground="{StaticResource WarningBrush}"
                               Visibility="{Binding HasRulesLine, Converter={StaticResource BoolToVis}}"/>
                </StackPanel>

                <StackPanel Grid.Column="1" Orientation="Horizontal">
                    <Button Style="{StaticResource OutlineButtonStyle}" Content="Export JSON"
                            Command="{Binding ExportJsonCommand}" Margin="0,0,8,0" Padding="12,6"/>
                    <Button Style="{StaticResource OutlineButtonStyle}" Content="Export CSV"
                            Command="{Binding ExportCsvCommand}" Padding="12,6"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Status cards -->
        <Grid Grid.Row="2" Margin="0,0,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Style="{StaticResource StatusCardBorder}">
                <StackPanel>
                    <TextBlock Text="{Binding RoomsSucceeded}" Style="{StaticResource StatusValue}"/>
                    <TextBlock Text="Succeeded" Style="{StaticResource StatusLabel}"/>
                </StackPanel>
            </Border>

            <Border Grid.Column="1" Style="{StaticResource StatusCardBorder}">
                <StackPanel>
                    <TextBlock Text="{Binding RoomsFailed}" Style="{StaticResource StatusValue}"
                               Foreground="{StaticResource DangerBrush}"/>
                    <TextBlock Text="Failed" Style="{StaticResource StatusLabel}"/>
                </StackPanel>
            </Border>

            <Border Grid.Column="2" Style="{StaticResource StatusCardBorder}">
                <StackPanel>
                    <TextBlock Text="{Binding RoomsSkipped}" Style="{StaticResource StatusValue}"
                               Foreground="{StaticResource WarningBrush}"/>
                    <TextBlock Text="Skipped" Style="{StaticResource StatusLabel}"/>
                </StackPanel>
            </Border>

            <Border Grid.Column="3" Style="{StaticResource StatusCardBorder}">
                <StackPanel>
                    <TextBlock Text="{Binding ReviewRequiredCount}" Style="{StaticResource StatusValue}"
                               Foreground="{StaticResource WarningBrush}"/>
                    <TextBlock Text="Review Required" Style="{StaticResource StatusLabel}"/>
                </StackPanel>
            </Border>

            <Border Grid.Column="4" Style="{StaticResource StatusCardBorder}">
                <StackPanel>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="{Binding DevicesPlaced}" Style="{StaticResource StatusValue}"/>
                        <TextBlock Text="/" Style="{StaticResource StatusValue}" Margin="2,0"
                                   Foreground="{StaticResource TextSecondaryBrush}"/>
                        <TextBlock Text="{Binding DevicesRequested}" Style="{StaticResource StatusValue}"
                                   Foreground="{StaticResource TextSecondaryBrush}"/>
                    </StackPanel>
                    <TextBlock Text="Devices Placed / Requested" Style="{StaticResource StatusLabel}"/>
                </StackPanel>
            </Border>
        </Grid>

        <!-- Room results table -->
        <Border Grid.Row="4" Style="{StaticResource CardBorder}">
            <Grid Margin="16,12">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <TextBlock Text="Room Results" Style="{StaticResource EyebrowText}" Margin="0,0,0,12"/>

                <DataGrid Grid.Row="1"
                          ItemsSource="{Binding RoomReports}"
                          AutoGenerateColumns="False"
                          IsReadOnly="True"
                          CanUserAddRows="False"
                          CanUserDeleteRows="False"
                          CanUserReorderColumns="False"
                          CanUserResizeRows="False"
                          CanUserSortColumns="True"
                          RowHeight="32"
                          ColumnHeaderHeight="28"
                          GridLinesVisibility="None"
                          BorderThickness="0"
                          Background="Transparent">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Room" Binding="{Binding RoomName}" Width="*"/>
                        <DataGridTextColumn Header="Level" Binding="{Binding LevelName}" Width="100"/>
                        <DataGridTextColumn Header="Status" Binding="{Binding Status}" Width="100"/>
                        <DataGridTextColumn Header="Placed" Binding="{Binding PointsPlaced}" Width="70"/>
                        <DataGridTextColumn Header="Requested" Binding="{Binding PointsRequested}" Width="80"/>
                        <DataGridTextColumn Header="Message" Binding="{Binding Message}" Width="3*"/>
                    </DataGrid.Columns>

                    <DataGrid.RowStyle>
                        <Style TargetType="DataGridRow">
                            <Setter Property="Background" Value="Transparent"/>
                            <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding Status}" Value="Failed">
                                    <Setter Property="Background" Value="#20FF4444"/>
                                </DataTrigger>
                                <DataTrigger Binding="{Binding Status}" Value="ReviewRequired">
                                    <Setter Property="Background" Value="#20FFA500"/>
                                </DataTrigger>
                                <DataTrigger Binding="{Binding Status}" Value="Success">
                                    <Setter Property="Background" Value="#2044FF44"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </DataGrid.RowStyle>
                </DataGrid>
            </Grid>
        </Border>

        <!-- Issue list -->
        <Border Grid.Row="5" Style="{StaticResource CardBorder}" Margin="0,12,0,0">
            <Grid Margin="16,12">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <TextBlock Text="Issues &amp; Warnings" Style="{StaticResource EyebrowText}" Margin="0,0,0,12"/>

                <ListBox Grid.Row="1" ItemsSource="{Binding Issues}" BorderThickness="0" Background="Transparent">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <StackPanel Orientation="Horizontal" Margin="0,2,0,2">
                                <Ellipse Width="8" Height="8" Margin="0,0,8,0" VerticalAlignment="Center">
                                    <Ellipse.Fill>
                                        <SolidColorBrush Color="{Binding SeverityColor}"/>
                                    </Ellipse.Fill>
                                </Ellipse>
                                <TextBlock Text="{Binding Message}" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}"/>
                            </StackPanel>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </Grid>
        </Border>
    </Grid>
</UserControl>
