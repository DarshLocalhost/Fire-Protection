<UserControl x:Class="FireProtection.UI.Views.Devices.DevicePlacementView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:vmDevices="clr-namespace:FireProtection.UI.ViewModels.Devices"
             xmlns:ctrl="clr-namespace:FireProtection.UI.Controls"
             xmlns:local="clr-namespace:FireProtection.UI.Converters"
             mc:Ignorable="d"
             d:DesignHeight="820" d:DesignWidth="1280"
             Background="Transparent"
             FontFamily="Segoe UI">
    <UserControl.InputBindings>
        <KeyBinding Key="Enter"
                    Modifiers="Ctrl"
                    Command="{Binding PlaceDevicesCommand}"/>
        <KeyBinding Key="Escape"
                    Command="{Binding CancelPlacementCommand}"/>
        <KeyBinding Key="R"
                    Modifiers="Ctrl"
                    Command="{Binding ResetCommand}"/>
        <KeyBinding Key="F5"
                    Command="{Binding ResetCommand}"/>
    </UserControl.InputBindings>
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/FireProtection.UI;component/Themes/Colors.xaml"/>
                <ResourceDictionary Source="/FireProtection.UI;component/Themes/Styles.xaml"/>
            </ResourceDictionary.MergedDictionaries>
            <local:RunLogLevelToBrushConverter x:Key="RunLogLevelToBrushConverter"/>
        </ResourceDictionary>
    </UserControl.Resources>

    <Grid Margin="16,0,16,16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="16"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- ================= TOP: DEVICE CONFIGURATION ================= -->
        <Border Grid.Row="0"
                Style="{StaticResource CardBorder}">
            <Grid Margin="18">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="12"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0"
                           Text="{Binding DeviceDisplayName}"
                           FontSize="15"
                           FontWeight="SemiBold"
                           Foreground="{StaticResource TextPrimaryBrush}"/>

                <WrapPanel Grid.Row="2">
                    <StackPanel Orientation="Horizontal" Margin="0,0,36,6">
                        <TextBlock Text="Device Family" Style="{StaticResource FieldLabel}"/>
                        <ComboBox Width="300"
                                  Style="{StaticResource StandardComboBoxStyle}"
                                  ItemsSource="{Binding DeviceFamilies}"
                                  SelectedItem="{Binding SelectedDeviceFamily, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                  DisplayMemberPath="FamilyName"/>
                    </StackPanel>

                    <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                        <TextBlock Text="Device Type" Style="{StaticResource FieldLabel}"/>
                        <ComboBox Width="300"
                                  Style="{StaticResource StandardComboBoxStyle}"
                                  ItemsSource="{Binding DeviceTypes}"
                                  SelectedItem="{Binding SelectedDeviceType, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                  DisplayMemberPath="TypeName"
                                  IsEnabled="{Binding IsDeviceFamilySelected}"/>
                    </StackPanel>
                </WrapPanel>
            </Grid>
        </Border>

        <!-- ================= MAIN CONTENT ================= -->
        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="0.28*" MinWidth="220" MaxWidth="320"/>
                <ColumnDefinition Width="16"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- ================= LEFT: LEVELS ================= -->
            <Border Grid.Row="0" Grid.Column="0"
                    Style="{StaticResource CardBorder}">

                <Grid Margin="14">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel Orientation="Horizontal">
                            <Rectangle Width="3" Height="14"
                                       Fill="{StaticResource BrassBrush}"
                                       Margin="0,0,10,0"
                                       VerticalAlignment="Center"/>
                            <TextBlock Text="LEVELS"
                                       Style="{StaticResource EyebrowText}"/>
                        </StackPanel>

                        <Button Grid.Column="1"
                                Style="{StaticResource OutlineButtonStyle}"
                                Command="{Binding ToggleHideUnselectedLevelsCommand}"
                                Padding="10,5">
                            <TextBlock FontSize="11.5" VerticalAlignment="Center">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Text" Value="Hide unselected"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding HideUnselectedLevels}" Value="True">
                                                <Setter Property="Text" Value="Show all"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </Button>
                    </Grid>

                    <ctrl:SearchBox Grid.Row="1"
                                    Margin="0,12,0,10"
                                    Text="{Binding LevelSearchText, UpdateSourceTrigger=PropertyChanged}"
                                    Placeholder="Search levels..."/>

                    <Grid Grid.Row="2" Margin="0,0,0,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="8"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="8"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <CheckBox Grid.Column="0"
                                  Content="Levels with rooms only"
                                  IsChecked="{Binding ShowLevelsWithRoomsOnly, Mode=TwoWay}"
                                  VerticalAlignment="Center"
                                  Foreground="{StaticResource TextSecondaryBrush}"
                                  FontSize="12"/>

                        <Button Grid.Column="3"
                                Grid.ColumnSpan="3"
                                Style="{StaticResource OutlineButtonStyle}"
                                Content="{Binding LevelSelectionToggleLabel}"
                                Command="{Binding ToggleSelectAllLevelsCommand}"/>
                    </Grid>

                    <ListBox Grid.Row="3"
                             ItemsSource="{Binding LevelsView}"
                             Background="Transparent"
                             BorderThickness="0"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                             VirtualizingPanel.IsVirtualizing="True"
                             VirtualizingPanel.VirtualizationMode="Recycling"
                             ItemContainerStyle="{StaticResource LevelListBoxItemStyle}">

                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Grid Margin="12,9">
                                    <Grid.Style>
                                        <Style TargetType="Grid">
                                            <Setter Property="Opacity" Value="1"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding HasRooms}" Value="False">
                                                    <Setter Property="Opacity" Value="0.45"/>
                                                    <Setter Property="ToolTip"
                                                            Value="This level has no rooms and cannot be selected for placement."/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Grid.Style>

                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>

                                    <CheckBox Grid.Column="0"
                                              IsChecked="{Binding IsSelected, Mode=TwoWay}"
                                              IsEnabled="{Binding HasRooms}"
                                              VerticalAlignment="Center"
                                              Margin="0,0,10,0"/>

                                    <StackPanel Grid.Column="1">
                                        <TextBlock Text="{Binding Name}"
                                                   FontSize="13"
                                                   FontWeight="SemiBold"
                                                   Foreground="{StaticResource TextPrimaryBrush}"
                                                   TextTrimming="CharacterEllipsis"/>
                                        <TextBlock FontSize="11"
                                                   Style="{StaticResource DataMuted}"
                                                   Margin="0,2,0,0">
                                            <Run Text="ELEV "/>
                                            <Run Text="{Binding ElevationFt,Mode=OneWay, StringFormat={}{0:F2} ft}"/>
                                        </TextBlock>
                                    </StackPanel>

                                    <Button Grid.Column="2"
                                            Style="{StaticResource OutlineButtonStyle}"
                                            Content="&#x22EF;"
                                            Padding="6,2"
                                            Margin="0,0,8,0"
                                            ToolTip="Level settings"
                                            Click="LevelSettingsButton_Click"
                                            Tag="{Binding}"
                                            Visibility="{Binding DataContext.HasLevelSettings, RelativeSource={RelativeSource AncestorType=UserControl}, Converter={StaticResource BoolToVis}}"
                                            VerticalAlignment="Center"/>

                                    <Border Grid.Column="3"
                                            VerticalAlignment="Center"
                                            Background="{StaticResource BackgroundOverlayBrush}"
                                            CornerRadius="3"
                                            Padding="7,3">
                                        <TextBlock FontSize="11.5"
                                                   Style="{StaticResource DataMuted}">
                                            <Run Text="{Binding SelectedRoomCount, Mode=OneWay}"/>
                                            <Run Text="/"/>
                                            <Run Text="{Binding TotalRoomCount, Mode=OneWay}"/>
                                        </TextBlock>
                                    </Border>
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>

                    <Border Grid.Row="4"
                            BorderBrush="{StaticResource DividerBrush}"
                            BorderThickness="0,1,0,0"
                            Padding="0,10,0,0"
                            Margin="0,10,0,0">
                        <TextBlock Text="{Binding SelectedLevelSummary}"
                                   FontSize="11.5"
                                   Style="{StaticResource DataMuted}"/>
                    </Border>
                </Grid>
            </Border>

            <!-- ================= RIGHT: ROOMS ================= -->
            <Border Grid.Row="0" Grid.Column="2"
                    Style="{StaticResource CardBorder}">

                <Grid Margin="18,14">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0" VerticalAlignment="Center">
                            <TextBlock Text="{Binding RoomsHeader}"
                                       FontSize="17"
                                       FontWeight="SemiBold"
                                       Foreground="{StaticResource TextPrimaryBrush}"/>
                            <TextBlock Text="{Binding RoomsFoundText}"
                                       FontSize="11.5"
                                       Style="{StaticResource DataMuted}"
                                       Margin="0,3,0,0"/>
                        </StackPanel>

                        <ctrl:SearchBox Grid.Column="1"
                                        Width="300" Margin="12,0"
                                        Text="{Binding RoomSearchText, UpdateSourceTrigger=PropertyChanged}"
                                        Placeholder="Search rooms by name or number..."/>

                        <Button Grid.Column="2"
                                Style="{StaticResource OutlineButtonStyle}"
                                Command="{Binding ToggleHideUnselectedRoomsCommand}"
                                Padding="10,5">
                            <TextBlock FontSize="11.5" VerticalAlignment="Center">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Text" Value="Hide unselected"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding HideUnselectedRooms}" Value="True">
                                                <Setter Property="Text" Value="Show all"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </Button>
                    </Grid>

                    <StackPanel Grid.Row="1" Margin="0,12,0,0">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <CheckBox Grid.Column="0"
                                      Content="Eligible rooms only"
                                      IsChecked="{Binding ShowEligibleRoomsOnly, Mode=TwoWay}"
                                      VerticalAlignment="Center"
                                      Foreground="{StaticResource TextSecondaryBrush}"
                                      FontSize="12"
                                      Margin="0,0,16,0"/>

                            <Button Grid.Column="1"
                                    Style="{StaticResource OutlineButtonStyle}"
                                    Content="{Binding RoomSelectionToggleLabel}"
                                    Command="{Binding ToggleSelectAllRoomsCommand}"
                                    HorizontalAlignment="Right"/>
                        </Grid>

                        <WrapPanel Margin="0,10,0,0" Orientation="Horizontal">
                            <TextBlock Text="IF ROOM ALREADY HAS DEVICES"
                                       Style="{StaticResource EyebrowText}"
                                       VerticalAlignment="Center"
                                       Margin="0,0,8,6"/>
                            <ComboBox Width="210"
                                      Margin="0,0,18,6"
                                      Style="{StaticResource StandardComboBoxStyle}"
                                      ItemsSource="{Binding ExistingDevicePolicyOptionLabels}"
                                      SelectedItem="{Binding SelectedExistingDevicePolicyLabel, Mode=TwoWay}"
                                      ToolTip="{Binding ExistingDevicePolicyTooltip}"/>

                            <Button Content="Apply family/type to selected"
                                    Style="{StaticResource OutlineButtonStyle}"
                                    Padding="10,4"
                                    Margin="0,0,6,6"
                                    Command="{Binding ApplyFamilyToSelectedCommand}"
                                    ToolTip="Copies the Device Family and Type chosen above onto every selected room."/>
                            <Button Content="Clear overrides"
                                    Style="{StaticResource OutlineButtonStyle}"
                                    Padding="10,4"
                                    Margin="0,0,12,6"
                                    Command="{Binding ClearRoomOverridesForSelectedCommand}"
                                    ToolTip="Resets Family/Type on every selected room back to the tab selection."/>

                            <TextBlock Text="{Binding BulkTargetSummary}"
                                       Style="{StaticResource DataMuted}"
                                       FontSize="11.5"
                                       VerticalAlignment="Center"
                                       Margin="0,0,0,6"/>
                        </WrapPanel>
                    </StackPanel>

                    <!-- ROOM TABLE HEADER (Status Column Removed) -->
                    <Border Grid.Row="2"
                            Background="{StaticResource BackgroundOverlayBrush}"
                            BorderBrush="{StaticResource DividerBrush}"
                            BorderThickness="0,1,0,1"
                            Padding="10,7"
                            Margin="0,12,0,0"
                            CornerRadius="3">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="36"/>
                                <ColumnDefinition Width="2.4*"/>
                                <ColumnDefinition Width="1.0*"/>
                                <ColumnDefinition Width="1.0*"/>
                                <ColumnDefinition Width="2.2*"/>
                                <ColumnDefinition Width="17"/>
                            </Grid.ColumnDefinitions>

                            <CheckBox Grid.Column="0" IsEnabled="False" VerticalAlignment="Center"/>
                            <TextBlock Grid.Column="1" Text="ROOM NAME" Margin="0,0,12,0" Style="{StaticResource EyebrowText}"/>
                            <TextBlock Grid.Column="2" Text="{Binding AreaColumnHeader}" Margin="0,0,12,0" TextAlignment="Center" Style="{StaticResource EyebrowTextRight}"/>
                            <TextBlock Grid.Column="3" Text="{Binding CeilingColumnHeader}" Margin="0,0,12,0" TextAlignment="Center" Style="{StaticResource EyebrowTextRight}"/>
                            <TextBlock Grid.Column="4" Text="FAMILY / TYPE" Margin="7,0,4,0" Style="{StaticResource EyebrowText}"/>
                        </Grid>
                    </Border>

                    <!-- VIRTUALIZED ROOM ROWS -->
                    <ItemsControl Grid.Row="3"
                                  ItemsSource="{Binding RoomsView}"
                                  VirtualizingPanel.IsVirtualizing="True"
                                  VirtualizingPanel.VirtualizationMode="Recycling"
                                  VirtualizingPanel.ScrollUnit="Pixel"
                                  ScrollViewer.CanContentScroll="True">
                        <ItemsControl.Template>
                            <ControlTemplate TargetType="ItemsControl">
                                <ScrollViewer CanContentScroll="True"
                                              VerticalScrollBarVisibility="Visible"
                                              HorizontalScrollBarVisibility="Disabled"
                                              Focusable="False">
                                    <ItemsPresenter/>
                                </ScrollViewer>
                            </ControlTemplate>
                        </ItemsControl.Template>
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <VirtualizingStackPanel Orientation="Vertical"/>
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border BorderBrush="{StaticResource DividerBrush}"
                                        BorderThickness="0,0,0,1"
                                        Padding="10,10">
                                    <Border.Style>
                                        <Style TargetType="Border">
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsEligible}" Value="False">
                                                    <Setter Property="Opacity" Value="0.5"/>
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding IsUndetermined}" Value="True">
                                                    <Setter Property="BorderBrush" Value="{StaticResource UndeterminedBrush}"/>
                                                    <Setter Property="BorderThickness" Value="3,0,0,1"/>
                                                    <Setter Property="Padding" Value="7,10,10,10"/>
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding IsBlocked}" Value="True">
                                                    <Setter Property="BorderBrush" Value="{StaticResource BlockedBrush}"/>
                                                    <Setter Property="BorderThickness" Value="3,0,0,1"/>
                                                    <Setter Property="Padding" Value="7,10,10,10"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>
                                    <Grid MinHeight="44">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="36"/>
                                            <ColumnDefinition Width="2.4*"/>
                                            <ColumnDefinition Width="1.0*"/>
                                            <ColumnDefinition Width="1.0*"/>
                                            <ColumnDefinition Width="2.2*"/>
                                        </Grid.ColumnDefinitions>

                                        <!-- Disabled CheckBox when room is ineligible -->
                                        <CheckBox Grid.Column="0"
                                                  IsChecked="{Binding IsSelected, Mode=TwoWay}"
                                                  IsEnabled="{Binding IsEligible}"
                                                  VerticalAlignment="Center"
                                                  ToolTip="{Binding EligibilityReason}"/>

                                        <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="0,0,12,0">
                                            <TextBlock Text="{Binding Name}"
                                                       FontSize="13"
                                                       FontWeight="SemiBold"
                                                       Foreground="{StaticResource TextPrimaryBrush}"
                                                       TextTrimming="CharacterEllipsis"
                                                       ToolTip="{Binding Name}"/>
                                            <!-- Short reason sub-line: displayed directly beneath the room name -->
                                            <TextBlock FontSize="10.5"
                                                       Margin="0,3,0,0"
                                                       TextTrimming="CharacterEllipsis"
                                                       ToolTip="{Binding EligibilityReason}">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock" BasedOn="{StaticResource DataMuted}">
                                                        <Setter Property="Visibility" Value="Collapsed"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsEligible}" Value="False">
                                                                <Setter Property="Visibility" Value="Visible"/>
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding IsBlocked}" Value="True">
                                                                <Setter Property="Foreground" Value="{StaticResource BlockedOnDarkBrush}"/>
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding IsUndetermined}" Value="True">
                                                                <Setter Property="Foreground" Value="{StaticResource UndeterminedOnDarkBrush}"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                                <Run Text="{Binding EligibilityState, Mode=OneWay}"
                                                     FontWeight="Bold"/>
                                                <Run Text=" &#x2014; "/>
                                                <Run Text="{Binding EligibilityShortReason, Mode=OneWay}"/>
                                            </TextBlock>
                                        </StackPanel>

                                        <TextBlock Grid.Column="2"
                                                   Text="{Binding AreaSqFt, StringFormat={}{0:N1}}"
                                                   Margin="0,0,12,0"
                                                   TextAlignment="Center"
                                                   Style="{StaticResource DataNumeric}"/>

                                        <TextBlock Grid.Column="3"
                                                   Text="{Binding CeilingHeightFt, StringFormat={}{0:F2}}"
                                                   Margin="0,0,12,0"
                                                   TextAlignment="Center"
                                                   Style="{StaticResource DataNumeric}"/>

                                        <StackPanel Grid.Column="4" VerticalAlignment="Center" Margin="0,0,4,0">
                                            <ComboBox Style="{StaticResource CellComboBoxStyle}"
                                                      ItemsSource="{Binding AvailableFamilies}"
                                                      SelectedItem="{Binding SelectedFamily, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                      ToolTip="Device family for this room. Defaults to the tab selection above."/>
                                            <ComboBox Style="{StaticResource CellComboBoxStyle}"
                                                      Margin="0,4,0,0"
                                                      ItemsSource="{Binding AvailableTypes}"
                                                      SelectedItem="{Binding SelectedType, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                      ToolTip="Device type for this room. The list follows this row's family."/>
                                        </StackPanel>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <Border Grid.Row="4"
                            BorderBrush="{StaticResource DividerBrush}"
                            BorderThickness="0,1,0,0"
                            Padding="0,10,0,0"
                            Margin="0,10,0,0">
                        <TextBlock Text="{Binding RoomsSelectedSummary}"
                                   FontSize="11.5"
                                   Style="{StaticResource DataMuted}"/>
                    </Border>
                </Grid>
            </Border>
        </Grid>

        <!-- ================= RUN LOG ================= -->
        <Border Grid.Row="3"
                Style="{StaticResource CardBorder}"
                Margin="0,12,0,0"
                Visibility="{Binding IsRunLogVisible, Converter={StaticResource BoolToVis}}">
            <Grid Margin="12">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <Grid Grid.Row="0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <TextBlock Grid.Column="0"
                               Text="Run Log"
                               FontSize="13"
                               FontWeight="SemiBold"
                               Foreground="{StaticResource TextPrimaryBrush}"
                               VerticalAlignment="Center"/>

                    <Button Grid.Column="1"
                            Style="{StaticResource OutlineButtonStyle}"
                            Content="Clear"
                            Padding="8,4"
                            Command="{Binding ClearRunLogCommand}"
                            ToolTip="Clear run log"/>
                </Grid>

                <ListBox Grid.Row="1"
                         ItemsSource="{Binding RunLogEntries}"
                         Margin="0,8,0,0"
                         Background="Transparent"
                         BorderThickness="0"
                         FontFamily="Consolas"
                         FontSize="11"
                         ScrollViewer.VerticalScrollBarVisibility="Auto"
                         MaxHeight="120">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding FormattedEntry}"
                                       Foreground="{Binding Level, Converter={StaticResource RunLogLevelToBrushConverter}}"
                                       TextTrimming="CharacterEllipsis"/>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </Grid>
        </Border>

        <!-- ================= BOTTOM ACTIONS ================= -->
        <Grid Grid.Row="4" Margin="0,16,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <ctrl:InfoBanner Grid.Column="0">
                <StackPanel>
                    <TextBlock FontSize="11.5"
                               Style="{StaticResource DataMuted}"
                               Text="{Binding CatalogStatusMessage}"/>
                    <TextBlock FontSize="11.5"
                               Style="{StaticResource DataMuted}"
                               Margin="0,2,0,0"
                               Text="{Binding PlacementStatusMessage}"/>
                </StackPanel>
            </ctrl:InfoBanner>

            <TextBlock Grid.Column="1"
                       Text="{Binding PlacementProgressText}"
                       Style="{StaticResource DataMuted}"
                       FontSize="11.5"
                       MaxWidth="260"
                       TextTrimming="CharacterEllipsis"
                       VerticalAlignment="Center"
                       Margin="16,0,0,0"
                       ToolTip="{Binding PlacementProgressText}"/>

            <Button Grid.Column="2"
                    Style="{StaticResource OutlineButtonStyle}"
                    Command="{Binding CancelPlacementCommand}"
                    Content="Cancel"
                    Padding="14,9"
                    Margin="10,0,0,0"
                    Visibility="{Binding CanCancelPlacement, Converter={StaticResource BoolToVis}}"/>

            <Button Grid.Column="3"
                    Style="{StaticResource PrimaryButtonStyle}"
                    Command="{Binding PlaceDevicesCommand}"
                    Margin="16,0,0,0">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="&#x2295;" FontSize="14" Margin="0,0,8,0" VerticalAlignment="Center"/>
                    <TextBlock Text="Place Devices" VerticalAlignment="Center"/>
                </StackPanel>
            </Button>

            <Button Grid.Column="4"
                    Style="{StaticResource OutlineButtonStyle}"
                    Command="{Binding ResetCommand}"
                    Margin="10,0,0,0"
                    Padding="18,9">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="&#x21BB;" FontSize="13" Margin="0,0,8,0" VerticalAlignment="Center"/>
                    <TextBlock Text="Reset" VerticalAlignment="Center"/>
                </StackPanel>
            </Button>
        </Grid>
    </Grid>
</UserControl>