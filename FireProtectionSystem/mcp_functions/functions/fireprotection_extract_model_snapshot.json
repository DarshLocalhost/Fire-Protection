{
  "name": "fireprotection_extract_model_snapshot",
  "title": "Extract full model snapshot",
  "description": "Extracts a complete model snapshot from the active Revit document including all linked architectural models. This performs full data extraction: levels (host + links in host coordinates), ceilings (3D solid recursive geometry with slope classification), rooms with boundary geometry and hazard classifications, obstacles (columns, beams, walls, MEP elements), and existing sprinklers from both host and linked models. All geometry is normalized to host MEP coordinates. The operation is read-only and does not modify the model. Use this when you need the complete model data for placement calculations or analysis. The extraction can take several seconds on large models with many linked files. Returns a structured ModelSnapshot DTO with summary statistics, warnings, and errors.",
  "input_schema": {
    "type": "object",
    "properties": {
      "export_file_path": {
        "type": "string",
        "description": "Optional path to export the snapshot as JSON. If omitted, the snapshot is returned in memory only."
      }
    },
    "additionalProperties": false
  },
  "output_schema": {
    "type": "object",
    "properties": {
      "schema_version": { "type": "string" },
      "units": {
        "type": "object",
        "properties": {
          "length": { "type": "string" },
          "area": { "type": "string" },
          "volume": { "type": "string" },
          "angle": { "type": "string" }
        },
        "required": ["length", "area", "volume", "angle"]
      },
      "coordinate_system": {
        "type": "object",
        "properties": {
          "canonical": { "type": "string" },
          "length_unit": { "type": "string" }
        },
        "required": ["canonical", "length_unit"]
      },
      "project": {
        "type": "object",
        "properties": {
          "name": { "type": "string" },
          "standard": { "type": "string" },
          "timestamp_utc": { "type": "string" }
        },
        "required": ["name", "standard", "timestamp_utc"]
      },
      "model": {
        "type": "object",
        "properties": {
          "host_document_title": { "type": "string" },
          "linked_documents": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "title": { "type": "string" },
                "path": { "type": "string" },
                "is_loaded": { "type": "boolean" },
                "room_count": { "type": "integer" }
              },
              "required": ["title", "path", "is_loaded", "room_count"]
            }
          }
        },
        "required": ["host_document_title", "linked_documents"]
      },
      "levels": {
        "type": "array",
        "items": {
          "type": "object",
          "properties": {
            "level_id": { "type": "string" },
            "name": { "type": "string" },
            "elevation_ft": { "type": "number" },
            "source_document": { "type": "string" },
            "source_level_id": { "type": "string" },
            "rooms": {
              "type": "array",
              "items": { "type": "string" }
            }
          },
          "required": ["level_id", "name", "elevation_ft", "source_document"]
        }
      },
      "rooms": {
        "type": "array",
        "items": {
          "type": "object",
          "properties": {
            "room_id": { "type": "string" },
            "element_id": { "type": "string" },
            "name": { "type": "string" },
            "number": { "type": "string" },
            "level_id": { "type": "string" },
            "level_name": { "type": "string" },
            "level_elevation_ft": { "type": "number" },
            "area_sq_ft": { "type": "number" },
            "volume_cu_ft": { "type": ["number", "null"] },
            "phase": { "type": "string" },
            "source": {
              "type": "object",
              "properties": {
                "document_title": { "type": "string" },
                "document_path": { "type": "string" },
                "is_from_link": { "type": "boolean" },
                "link_instance_id": { "type": "string" },
                "link_name": { "type": "string" }
              },
              "required": ["document_title", "document_path", "is_from_link", "link_instance_id", "link_name"]
            },
            "location_point": {
              "type": ["object", "null"],
              "properties": {
                "x": { "type": "number" },
                "y": { "type": "number" },
                "z": { "type": "number" }
              },
              "required": ["x", "y", "z"]
            },
            "bounding_box": {
              "type": ["object", "null"],
              "properties": {
                "min": {
                  "type": "object",
                  "properties": { "x": { "type": "number" }, "y": { "type": "number" }, "z": { "type": "number" } },
                  "required": ["x", "y", "z"]
                },
                "max": {
                  "type": "object",
                  "properties": { "x": { "type": "number" }, "y": { "type": "number" }, "z": { "type": "number" } },
                  "required": ["x", "y", "z"]
                }
              },
              "required": ["min", "max"]
            },
            "boundary": {
              "type": "object",
              "properties": {
                "polygon": {
                  "type": "array",
                  "items": { "type": "array", "items": { "type": "number" }, "minItems": 2, "maxItems": 2 }
                },
                "outer_loop": {
                  "type": "object",
                  "properties": {
                    "is_outer": { "type": "boolean" },
                    "polygon": {
                      "type": "array",
                      "items": { "type": "array", "items": { "type": "number" }, "minItems": 2, "maxItems": 2 }
                    },
                    "segments": {
                      "type": "array",
                      "items": {
                        "type": "object",
                        "properties": {
                          "type": { "type": "string" },
                          "start": { "type": "object", "properties": { "x": { "type": "number" }, "y": { "type": "number" }, "z": { "type": "number" } }, "required": ["x", "y", "z"] },
                          "end": { "type": "object", "properties": { "x": { "type": "number" }, "y": { "type": "number" }, "z": { "type": "number" } }, "required": ["x", "y", "z"] },
                          "mid": { "type": "object", "properties": { "x": { "type": "number" }, "y": { "type": "number" }, "z": { "type": "number" } }, "required": ["x", "y", "z"] },
                          "length_ft": { "type": "number" },
                          "radius_ft": { "type": ["number", "null"] },
                          "is_wall": { "type": "boolean" }
                        },
                        "required": ["type", "start", "end", "mid", "length_ft", "is_wall"]
                      }
                    }
                  },
                  "required": ["is_outer", "polygon", "segments"]
                },
                "inner_loops": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "properties": {
                      "is_outer": { "type": "boolean" },
                      "polygon": {
                        "type": "array",
                        "items": { "type": "array", "items": { "type": "number" }, "minItems": 2, "maxItems": 2 }
                      },
                      "segments": {
                        "type": "array",
                        "items": {
                          "type": "object",
                          "properties": {
                            "type": { "type": "string" },
                            "start": { "type": "object", "properties": { "x": { "type": "number" }, "y": { "type": "number" }, "z": { "type": "number" } }, "required": ["x", "y", "z"] },
                            "end": { "type": "object", "properties": { "x": { "type": "number" }, "y": { "type": "number" }, "z": { "type": "number" } }, "required": ["x", "y", "z"] },
                            "mid": { "type": "object", "properties": { "x": { "type": "number" }, "y": { "type": "number" }, "z": { "type": "number" } }, "required": ["x", "y", "z"] },
                            "length_ft": { "type": "number" },
                            "radius_ft": { "type": ["number", "null"] },
                            "is_wall": { "type": "boolean" }
                          },
                          "required": ["type", "start", "end", "mid", "length_ft", "is_wall"]
                        }
                      }
                    },
                    "required": ["is_outer", "polygon", "segments"]
                  }
                }
              },
              "required": ["polygon", "outer_loop", "inner_loops"]
            },
            "hazard": {
              "type": "object",
              "properties": {
                "hazard_class": { "type": "string" },
                "matched_keyword": { "type": "string" },
                "matched_terms": { "type": "array", "items": { "type": "string" } },
                "requires_review": { "type": "boolean" }
              },
              "required": ["hazard_class", "matched_keyword", "matched_terms", "requires_review"]
            },
            "classification": {
              "type": "object",
              "properties": {
                "hazard_class": { "type": "string" },
                "suggested_by_classifier": { "type": "string" },
                "overridden": { "type": "boolean" },
                "confirmed_by": { "type": "string" }
              },
              "required": ["hazard_class", "suggested_by_classifier", "overridden", "confirmed_by"]
            },
            "geometry": {
              "type": "object",
              "properties": {
                "polygon": {
                  "type": "array",
                  "items": { "type": "array", "items": { "type": "number" }, "minItems": 2, "maxItems": 2 }
                },
                "ceiling_height_ft": { "type": ["number", "null"] },
                "ceiling_type": { "type": "string" }
              },
              "required": ["polygon", "ceiling_type"]
            },
            "ceilings": {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "element_id": { "type": "string" },
                  "level_id": { "type": "string" },
                  "level_name": { "type": "string" },
                  "ceiling_name": { "type": "string" },
                  "family_name": { "type": "string" },
                  "type_name": { "type": "string" },
                  "category": { "type": "string" },
                  "source": {
                    "type": "object",
                    "properties": {
                      "document_title": { "type": "string" },
                      "document_path": { "type": "string" },
                      "is_from_link": { "type": "boolean" },
                      "link_instance_id": { "type": "string" },
                      "link_name": { "type": "string" }
                    },
                    "required": ["document_title", "document_path", "is_from_link", "link_instance_id", "link_name"]
                  },
                  "bounding_box": {
                    "type": ["object", "null"],
                    "properties": {
                      "min": { "type": "object", "properties": { "x": { "type": "number" }, "y": { "type": "number" }, "z": { "type": "number" } }, "required": ["x", "y", "z"] },
                      "max": { "type": "object", "properties": { "x": { "type": "number" }, "y": { "type": "number" }, "z": { "type": "number" } }, "required": ["x", "y", "z"] }
                    },
                    "required": ["min", "max"]
                  },
                  "bottom_elevation_ft": { "type": ["number", "null"] },
                  "top_elevation_ft": { "type": ["number", "null"] },
                  "height_above_level_ft": { "type": ["number", "null"] },
                  "slope_type": { "type": "string" },
                  "slope_degrees": { "type": ["number", "null"] },
                  "boundary_polygon": {
                    "type": "array",
                    "items": { "type": "array", "items": { "type": "number" }, "minItems": 2, "maxItems": 2 }
                  },
                  "thickness_ft": { "type": ["number", "null"] },
                  "is_room_direct_ceiling": { "type": "boolean" },
                  "is_model_group": { "type": "boolean" },
                  "area_sq_ft": { "type": "number" },
                  "has_readable_grid": { "type": "boolean" },
                  "grid_origin_x_ft": { "type": "number" },
                  "grid_origin_y_ft": { "type": "number" },
                  "grid_spacing_u_ft": { "type": "number" },
                  "grid_spacing_v_ft": { "type": "number" },
                  "grid_angle_rad": { "type": "number" },
                  "grid_origin_source": { "type": "string" },
                  "notes": { "type": "string" }
                },
                "required": ["element_id", "level_id", "level_name", "ceiling_name", "family_name", "type_name", "category", "source", "slope_type", "boundary_polygon", "area_sq_ft", "has_readable_grid", "grid_origin_x_ft", "grid_origin_y_ft", "grid_spacing_u_ft", "grid_spacing_v_ft", "grid_angle_rad", "grid_origin_source"]
              }
            },
            "associated_obstacle_ids": { "type": "array", "items": { "type": "string" } },
            "requires_human_review": { "type": "boolean" },
            "warnings": { "type": "array", "items": { "type": "string" } }
          },
          "required": ["room_id", "element_id", "name", "number", "level_id", "level_name", "level_elevation_ft", "area_sq_ft", "phase", "source", "location_point", "bounding_box", "boundary", "hazard", "classification", "geometry", "ceilings", "associated_obstacle_ids", "requires_human_review", "warnings"]
        }
      },
      "ceilings": {
        "type": "array",
        "items": {
          "type": "object",
          "properties": {
            "element_id": { "type": "string" },
            "level_id": { "type": "string" },
            "level_name": { "type": "string" },
            "ceiling_name": { "type": "string" },
            "family_name": { "type": "string" },
            "type_name": { "type": "string" },
            "category": { "type": "string" },
            "source": {
              "type": "object",
              "properties": {
                "document_title": { "type": "string" },
                "document_path": { "type": "string" },
                "is_from_link": { "type": "boolean" },
                "link_instance_id": { "type": "string" },
                "link_name": { "type": "string" }
              },
              "required": ["document_title", "document_path", "is_from_link", "link_instance_id", "link_name"]
            },
            "bounding_box": {
              "type": ["object", "null"],
              "properties": {
                "min": { "type": "object", "properties": { "x": { "type": "number" }, "y": { "type": "number" }, "z": { "type": "number" } }, "required": ["x", "y", "z"] },
                "max": { "type": "object", "properties": { "x": { "type": "number" }, "y": { "type": "number" }, "z": { "type": "number" } }, "required": ["x", "y", "z"] }
              },
              "required": ["min", "max"]
            },
            "bottom_elevation_ft": { "type": ["number", "null"] },
            "top_elevation_ft": { "type": ["number", "null"] },
            "height_above_level_ft": { "type": ["number", "null"] },
            "slope_type": { "type": "string" },
            "slope_degrees": { "type": ["number", "null"] },
            "boundary_polygon": {
              "type": "array",
              "items": { "type": "array", "items": { "type": "number" }, "minItems": 2, "maxItems": 2 }
            },
            "thickness_ft": { "type": ["number", "null"] },
            "is_room_direct_ceiling": { "type": "boolean" },
            "is_model_group": { "type": "boolean" },
            "area_sq_ft": { "type": "number" },
            "has_readable_grid": { "type": "boolean" },
            "grid_origin_x_ft": { "type": "number" },
            "grid_origin_y_ft": { "type": "number" },
            "grid_spacing_u_ft": { "type": "number" },
            "grid_spacing_v_ft": { "type": "number" },
            "grid_angle_rad": { "type": "number" },
            "grid_origin_source": { "type": "string" },
            "notes": { "type": "string" }
          },
          "required": ["element_id", "level_id", "level_name", "ceiling_name", "family_name", "type_name", "category", "source", "slope_type", "boundary_polygon", "area_sq_ft", "has_readable_grid", "grid_origin_x_ft", "grid_origin_y_ft", "grid_spacing_u_ft", "grid_spacing_v_ft", "grid_angle_rad", "grid_origin_source"]
        }
      },
      "existing_sprinklers": {
        "type": "array",
        "items": {
          "type": "object",
          "properties": {
            "element_id": { "type": "string" },
            "room_id": { "type": "string" },
            "room_name": { "type": "string" },
            "family_name": { "type": "string" },
            "type_name": { "type": "string" },
