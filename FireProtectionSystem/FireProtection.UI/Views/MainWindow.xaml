<Window x:Class="FireProtection.UI.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vmNotif="clr-namespace:FireProtection.UI.ViewModels.NotificationAppliances"
        xmlns:vmSmoke="clr-namespace:FireProtection.UI.ViewModels.SmokeDetectors"
        xmlns:vmSprinklers="clr-namespace:FireProtection.UI.ViewModels.Sprinklers"
        xmlns:vNotif="clr-namespace:FireProtection.UI.Views.NotificationAppliances"
        xmlns:vSmoke="clr-namespace:FireProtection.UI.Views.SmokeDetectors"
        xmlns:vSprinklers="clr-namespace:FireProtection.UI.Views.Sprinklers"
        Width="1400"
        Height="900"
        Background="{DynamicResource BackgroundBrush}"
        FontFamily="Segoe UI"
        Title="Fire Protection System"
        WindowStartupLocation="CenterScreen"
        mc:Ignorable="d">
  <Window.Resources>
    <ResourceDictionary>
      <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="/FireProtection.UI;component/Themes/Colors.xaml"/>
        <ResourceDictionary Source="/FireProtection.UI;component/Themes/Styles.xaml"/>
      </ResourceDictionary.MergedDictionaries>

      <!-- ViewModel -> View mapping -->
      <DataTemplate DataType="{x:Type vmSprinklers:SprinklerViewModel}">
        <vSprinklers:SprinklerView />
      </DataTemplate>
      <DataTemplate DataType="{x:Type vmSmoke:SmokeDetectorViewModel}">
        <vSmoke:SmokeDetectorView />
      </DataTemplate>
      <DataTemplate DataType="{x:Type vmNotif:NotificationApplianceViewModel}">
        <vNotif:NotificationApplianceView />
      </DataTemplate>
    </ResourceDictionary>
  </Window.Resources>
  <Grid Background="{DynamicResource BackgroundBrush}">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
    </Grid.RowDefinitions>

    <!-- ================= HEADER ================= -->
    <Border Grid.Row="0"
        Background="{DynamicResource BackgroundBrush}"
            BorderBrush="{StaticResource BorderBrush}"
            BorderThickness="0"
            Padding="24,16,24,0">
      <StackPanel Orientation="Horizontal">
        <!-- Brand mark: sprinkler deflector plate -->
        <Border Width="38"
                Height="38"
                VerticalAlignment="Center"
                Background="{StaticResource BrandBrush}"
                CornerRadius="4">
          <Canvas Width="20" Height="20" HorizontalAlignment="Center" VerticalAlignment="Center">
            <!-- deflector -->
            <Rectangle Canvas.Left="4" Canvas.Top="5" Width="12" Height="2.5"
                       Fill="White" RadiusX="1" RadiusY="1"/>
            <!-- stem -->
            <Rectangle Canvas.Left="9" Canvas.Top="7.5" Width="2" Height="6"
                       Fill="White"/>
            <!-- drop -->
            <Path Data="M 10,14 C 12.5,17 12.5,18.5 10,18.5 C 7.5,18.5 7.5,17 10,14 Z"
                  Fill="White"/>
          </Canvas>
        </Border>
        <StackPanel Margin="12,0,0,0" VerticalAlignment="Center">
          <TextBlock FontSize="17"
                     FontWeight="SemiBold"
                     Foreground="{StaticResource TextPrimaryBrush}"
                     Text="Fire Protection System"/>
          <TextBlock Margin="0,2,0,0"
                     FontFamily="{StaticResource DataFontFamily}"
                     FontSize="10.5"
                     Foreground="{StaticResource TextMutedBrush}"
                     Text="AUTOMATED LAYOUT WITH CODE-BASED CALCULATIONS"/>
        </StackPanel>
      </StackPanel>
    </Border>

    <!-- Top-level tabs -->
    <TabControl Margin="0,0,0,0"
                HorizontalAlignment="Stretch"
                VerticalAlignment="Stretch"
                Background="{x:Null}"
                ItemContainerStyle="{StaticResource TopTabItemStyle}"
                Style="{StaticResource TopTabControlStyle}"
                Grid.Row="1">
          <TabItem Header="Sprinklers">
            <ContentControl Content="{Binding Sprinkler}" />
          </TabItem>
          <TabItem Header="Smoke Detectors">
            <ContentControl Content="{Binding SmokeDetector}" />
          </TabItem>
          <TabItem Header="Notification Appliances">
            <ContentControl Content="{Binding NotificationAppliance}" />
          </TabItem>
        </TabControl>
  </Grid>
</Window>