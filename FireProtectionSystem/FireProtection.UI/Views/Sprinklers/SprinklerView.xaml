<UserControl x:Class="FireProtection.UI.Views.Sprinklers.SprinklerView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vmCollision="clr-namespace:FireProtection.UI.ViewModels.Sprinklers.Collision"
             xmlns:vmBruteForce="clr-namespace:FireProtection.UI.ViewModels.Sprinklers.BruteForce"
             xmlns:vCollision="clr-namespace:FireProtection.UI.Views.Sprinklers.Collision"
             xmlns:vBruteForce="clr-namespace:FireProtection.UI.Views.Sprinklers.BruteForce"
             FontFamily="Segoe UI">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/FireProtection.UI;component/Themes/Colors.xaml"/>
                <ResourceDictionary Source="/FireProtection.UI;component/Themes/Styles.xaml"/>
            </ResourceDictionary.MergedDictionaries>

            <!-- Header templates: label per sub-view-model type -->
        <DataTemplate x:Key="CollisionHeaderTemplate"
                      DataType="{x:Type vmCollision:SprinklerCollisionViewModel}">
            <TextBlock Text="Final"/>
        </DataTemplate>

        <DataTemplate x:Key="BruteForceHeaderTemplate"
                      DataType="{x:Type vmBruteForce:SprinklerBruteForceViewModel}">
            <TextBlock Text="Preliminary"/>
        </DataTemplate>

        <!-- Header template selector -->
        <local:SprinklerSubTabHeaderTemplateSelector
            x:Key="SprinklerSubTabHeaderTemplateSelector"
            xmlns:local="clr-namespace:FireProtection.UI.Views.Sprinklers"
            CollisionTemplate="{StaticResource CollisionHeaderTemplate}"
            BruteForceTemplate="{StaticResource BruteForceHeaderTemplate}"/>

        <!-- Sub-view ViewModel -> View mapping -->
        <DataTemplate DataType="{x:Type vmCollision:SprinklerCollisionViewModel}">
            <vCollision:SprinklerCollisionView/>
        </DataTemplate>

        <DataTemplate DataType="{x:Type vmBruteForce:SprinklerBruteForceViewModel}">
            <vBruteForce:SprinklerBruteForceView/>
        </DataTemplate>
        </ResourceDictionary>
    </UserControl.Resources>

    <Grid Margin="20" Background="{StaticResource SubtleBrush}">
        <TabControl Style="{StaticResource SubTabControlStyle}"
                    ItemContainerStyle="{StaticResource SubTabItemStyle}"
                    ItemsSource="{Binding SubTabViewModels}"
                    SelectedItem="{Binding SelectedSubTabViewModel, Mode=TwoWay}"
                    ItemTemplateSelector="{StaticResource SprinklerSubTabHeaderTemplateSelector}"/>
    </Grid>

</UserControl>
