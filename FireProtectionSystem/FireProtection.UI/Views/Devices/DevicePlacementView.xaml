<UserControl x:Class="FireProtection.UI.Views.Devices.DevicePlacementView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:vmDevices="clr-namespace:FireProtection.UI.ViewModels.Devices"
             xmlns:ctrl="clr-namespace:FireProtection.UI.Controls"
             mc:Ignorable="d"
             d:DesignHeight="820" d:DesignWidth="1280"
             Background="Transparent"
             FontFamily="Segoe UI">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/FireProtection.UI;component/Themes/Colors.xaml"/>
                <ResourceDictionary Source="/FireProtection.UI;component/Themes/Styles.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>

    <!-- No top margin: the hosting device tab already puts its parameter card 16px in from the
         edge and leaves a 12px gutter above this control, so the cards below line up with it. -->
    <Grid Margin="16,0,16,16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="16"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- ================= TOP: DEVICE CONFIGURATION ================= -->
        <Border Grid.Row="0"
                Background="{StaticResource SurfaceBrush}"
                BorderBrush="{StaticResource BorderBrush}"
                BorderThickness="1"
                CornerRadius="6">
            <Grid Margin="18">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="12"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0"
                           Text="{Binding DeviceDisplayName}"
                           FontSize="15"
                           FontWeight="SemiBold"
                           Foreground="{StaticResource TextPrimaryBrush}"/>

                <!-- Label packed directly against its own control (10px), 36px between pairs, so a
                     caption reads as belonging to the combo beside it. WrapPanel so the pairs wrap
                     rather than clip when the window is narrow. -->
                <WrapPanel Grid.Row="2">
                    <StackPanel Orientation="Horizontal" Margin="0,0,36,6">
                        <TextBlock Text="Device Family" Style="{StaticResource FieldLabel}"/>
                        <ComboBox Width="300"
                                  Style="{StaticResource StandardComboBoxStyle}"
                                  ItemsSource="{Binding DeviceFamilies}"
                                  SelectedItem="{Binding SelectedDeviceFamily, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                  DisplayMemberPath="FamilyName"/>
                    </StackPanel>

                    <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                        <TextBlock Text="Device Type" Style="{StaticResource FieldLabel}"/>
                        <ComboBox Width="300"
                                  Style="{StaticResource StandardComboBoxStyle}"
                                  ItemsSource="{Binding DeviceTypes}"
                                  SelectedItem="{Binding SelectedDeviceType, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                  DisplayMemberPath="TypeName"
                                  IsEnabled="{Binding IsDeviceFamilySelected}"/>
                    </StackPanel>
                </WrapPanel>
            </Grid>
        </Border>

        <!-- ================= MAIN CONTENT ================= -->
        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <!-- Proportional with a floor and a ceiling: the levels pane no longer eats a fixed 300px
                     out of a narrow window, and never grows past 320px on a wide one. -->
                <ColumnDefinition Width="0.28*" MinWidth="220" MaxWidth="320"/>
                <ColumnDefinition Width="16"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- ================= LEFT: LEVELS ================= -->
            <Border Grid.Row="0" Grid.Column="0"
                    Background="{StaticResource SurfaceBrush}"
                    BorderBrush="{StaticResource BorderBrush}"
                    BorderThickness="1"
                    CornerRadius="6">

                <Grid Margin="14">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <TextBlock Text="Level Selection"
                                   FontSize="15"
                                   FontWeight="SemiBold"
                                   Foreground="{StaticResource TextPrimaryBrush}"
                                   VerticalAlignment="Center"/>

                        <Button Grid.Column="1"
                                Style="{StaticResource OutlineButtonStyle}"
                                Command="{Binding ToggleHideUnselectedLevelsCommand}">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#x1F441;" FontSize="12" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                <TextBlock VerticalAlignment="Center">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Text" Value="Hide Unselected"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding HideUnselectedLevels}" Value="True">
                                                    <Setter Property="Text" Value="Show All"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </StackPanel>
                        </Button>
                    </Grid>

                    <ctrl:SearchBox Grid.Row="1"
                                    Margin="0,12,0,10"
                                    Text="{Binding LevelSearchText, UpdateSourceTrigger=PropertyChanged}"
                                    Placeholder="Search levels..."/>

                    <Grid Grid.Row="2" Margin="0,0,0,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="8"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="8"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <CheckBox Grid.Column="0"
                                  Content="Show levels with rooms only"
                                  IsChecked="{Binding ShowLevelsWithRoomsOnly, Mode=TwoWay}"
                                  VerticalAlignment="Center"
                                  Foreground="{StaticResource TextSecondaryBrush}"
                                  FontSize="12"/>

                        <Button Grid.Column="3"
                                Grid.ColumnSpan="3"
                                Style="{StaticResource OutlineButtonStyle}"
                                Content="{Binding LevelSelectionToggleLabel}"
                                Command="{Binding ToggleSelectAllLevelsCommand}"/>
                    </Grid>

                    <ListBox Grid.Row="3"
                             ItemsSource="{Binding LevelsView}"
                             Background="Transparent"
                             BorderThickness="0"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                             VirtualizingPanel.IsVirtualizing="True"
                             VirtualizingPanel.VirtualizationMode="Recycling"
                             ItemContainerStyle="{StaticResource LevelListBoxItemStyle}">

                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Grid Margin="12,10">
                                    <Grid.Style>
                                        <Style TargetType="Grid">
                                            <Setter Property="Opacity" Value="1"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding HasRooms}" Value="False">
                                                    <Setter Property="Opacity" Value="0.5"/>
                                                    <Setter Property="ToolTip"
                                                            Value="This level has no rooms and cannot be selected for placement."/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Grid.Style>

                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>

                                    <CheckBox Grid.Column="0"
                                              IsChecked="{Binding IsSelected, Mode=TwoWay}"
                                              IsEnabled="{Binding HasRooms}"
                                              VerticalAlignment="Center"
                                              Margin="0,0,10,0"/>

                                    <StackPanel Grid.Column="1">
                                        <TextBlock Text="{Binding Name}"
                                                   FontSize="14"
                                                   FontWeight="SemiBold"
                                                   Foreground="{StaticResource TextPrimaryBrush}"/>
                                        <TextBlock FontSize="12"
                                                   Foreground="{StaticResource TextSecondaryBrush}"
                                                   Margin="0,2,0,0">
                                            <Run Text="Elev."/>
                                            <Run Text="{Binding ElevationFt,Mode=OneWay, StringFormat={}{0:F2} ft}"/>
                                        </TextBlock>
                                    </StackPanel>

                                    <Button Grid.Column="2"
                                            Style="{StaticResource OutlineButtonStyle}"
                                            Content="&#x22EF;"
                                            Padding="6,2"
                                            Margin="0,0,8,0"
                                            ToolTip="Level settings (declarative metadata only)"
                                            Click="LevelSettingsButton_Click"
                                            Tag="{Binding}"
                                            VerticalAlignment="Center"/>

                                    <TextBlock Grid.Column="3"
                                               VerticalAlignment="Center"
                                               FontSize="13"
                                               FontWeight="SemiBold"
                                               Foreground="{StaticResource TextSecondaryBrush}">
                                        <Run Text="{Binding SelectedRoomCount, Mode=OneWay}"/>
                                        <Run Text="/"/>
                                        <Run Text="{Binding TotalRoomCount, Mode=OneWay}"/>
                                    </TextBlock>
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>

                    <Border Grid.Row="4"
                            BorderBrush="{StaticResource BorderBrush}"
                            BorderThickness="0,1,0,0"
                            Padding="0,10,0,0"
                            Margin="0,10,0,0">
                        <TextBlock Text="{Binding SelectedLevelSummary}"
                                   FontSize="12"
                                   Foreground="{StaticResource TextSecondaryBrush}"/>
                    </Border>
                </Grid>
            </Border>

            <!-- ================= RIGHT: ROOMS ================= -->
            <Border Grid.Row="0" Grid.Column="2"
                    Background="{StaticResource SurfaceBrush}"
                    BorderBrush="{StaticResource BorderBrush}"
                    BorderThickness="1"
                    CornerRadius="6">

                <Grid Margin="18">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0" VerticalAlignment="Center">
                            <TextBlock Text="{Binding RoomsHeader}"
                                       FontSize="18"
                                       FontWeight="SemiBold"
                                       Foreground="{StaticResource TextPrimaryBrush}"/>
                            <TextBlock Text="{Binding RoomsFoundText}"
                                       FontSize="12"
                                       Foreground="{StaticResource TextSecondaryBrush}"
                                       Margin="0,4,0,0"/>
                        </StackPanel>

                        <ctrl:SearchBox Grid.Column="1"
                                        Width="320" Margin="12,0"
                                        Text="{Binding RoomSearchText, UpdateSourceTrigger=PropertyChanged}"
                                        Placeholder="Search rooms by name or number..."/>

                        <Button Grid.Column="2"
                                Style="{StaticResource OutlineButtonStyle}"
                                Command="{Binding ToggleHideUnselectedRoomsCommand}">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#x1F441;" FontSize="12" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                <TextBlock VerticalAlignment="Center">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Text" Value="Hide Unselected"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding HideUnselectedRooms}" Value="True">
                                                    <Setter Property="Text" Value="Show All"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </StackPanel>
                        </Button>
                    </Grid>

                    <StackPanel Grid.Row="1" Margin="0,12,0,0">
                        <Button Style="{StaticResource OutlineButtonStyle}"
                                Content="{Binding RoomSelectionToggleLabel}"
                                Command="{Binding ToggleSelectAllRoomsCommand}"
                                HorizontalAlignment="Right"/>

                        <!-- Bulk edit (item 8, list 2) + re-run policy (item 3, list 2). WrapPanel so a narrow
                             window wraps rather than clips. Both act on the rooms that are selected. -->
                        <WrapPanel Margin="0,10,0,0" Orientation="Horizontal">
                            <TextBlock Text="If room already has devices"
                                       FontSize="12"
                                       FontWeight="SemiBold"
                                       Foreground="{StaticResource TextSecondaryBrush}"
                                       VerticalAlignment="Center"
                                       Margin="0,0,8,6"/>
                            <ComboBox Width="210"
                                      Margin="0,0,18,6"
                                      Style="{StaticResource StandardComboBoxStyle}"
                                      ItemsSource="{Binding ExistingDevicePolicyOptionLabels}"
                                      SelectedItem="{Binding SelectedExistingDevicePolicyLabel, Mode=TwoWay}"
                                      ToolTip="{Binding ExistingDevicePolicyTooltip}"/>

                            <Button Content="Apply family/type to selected"
                                    Style="{StaticResource OutlineButtonStyle}"
                                    Padding="10,4"
                                    Margin="0,0,6,6"
                                    Command="{Binding ApplyFamilyToSelectedCommand}"
                                    ToolTip="Copies the Device Family and Type chosen above onto every selected room."/>
                            <Button Content="Clear overrides"
                                    Style="{StaticResource OutlineButtonStyle}"
                                    Padding="10,4"
                                    Margin="0,0,12,6"
                                    Command="{Binding ClearRoomOverridesForSelectedCommand}"
                                    ToolTip="Resets Family/Type on every selected room back to the tab selection."/>

                            <TextBlock Text="{Binding BulkTargetSummary}"
                                       FontSize="12"
                                       Foreground="{StaticResource TextSecondaryBrush}"
                                       VerticalAlignment="Center"
                                       Margin="0,0,0,6"/>
                        </WrapPanel>
                    </StackPanel>

                    <Border Grid.Row="2"
                            BorderBrush="{StaticResource BorderBrush}"
                            BorderThickness="0,1,0,1"
                            Padding="0,10"
                            Margin="0,12,0,0">
                        <Grid>
                            <!-- Column widths and per-column margins are duplicated verbatim in the row
                                 DataTemplate below; the two must be edited together or the header stops
                                 lining up with its values. Numeric columns are centred so they sit clear
                                 of the Family / Type combos instead of crowding them. The last column here
                                 is a scrollbar reserve: the list's scrollbar takes that width out of the
                                 rows but not out of this header, so without it every column drifts. -->
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="36"/>
                                <ColumnDefinition Width="2.2*"/>
                                <ColumnDefinition Width="1.0*"/>
                                <ColumnDefinition Width="1.0*"/>
                                <ColumnDefinition Width="2.4*"/>
                                <ColumnDefinition Width="17"/>
                            </Grid.ColumnDefinitions>

                            <CheckBox Grid.Column="0" IsEnabled="False" VerticalAlignment="Center"/>
                            <TextBlock Grid.Column="1" Text="Room Name" Margin="0,0,16,0" VerticalAlignment="Center" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource TextSecondaryBrush}"/>
                            <TextBlock Grid.Column="2" Text="{Binding AreaColumnHeader}" Margin="0,0,16,0" VerticalAlignment="Center" TextAlignment="Center" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource TextSecondaryBrush}"/>
                            <TextBlock Grid.Column="3" Text="{Binding CeilingColumnHeader}" Margin="0,0,20,0" VerticalAlignment="Center" TextAlignment="Center" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource TextSecondaryBrush}"/>
                            <!-- 7 = the combo's own left padding, so this header lines up with the text
                                 inside the combo below rather than with its border. -->
                            <TextBlock Grid.Column="4" Text="Family / Type" Margin="7,0,4,0" VerticalAlignment="Center" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource TextSecondaryBrush}"/>
                        </Grid>
                    </Border>

                    <!-- Virtualized room list (item 1). An ItemsControl inside a ScrollViewer measures with
                         infinite height and realizes EVERY row; giving the ItemsControl its own template with
                         the ScrollViewer inside it plus a recycling VirtualizingStackPanel realizes only the
                         visible rows. Checkbox state lives on the ViewModel, so scrolling never loses a tick. -->
                    <ItemsControl Grid.Row="3"
                                  ItemsSource="{Binding RoomsView}"
                                  VirtualizingPanel.IsVirtualizing="True"
                                  VirtualizingPanel.VirtualizationMode="Recycling"
                                  VirtualizingPanel.ScrollUnit="Pixel"
                                  ScrollViewer.CanContentScroll="True">
                        <ItemsControl.Template>
                            <ControlTemplate TargetType="ItemsControl">
                                <ScrollViewer CanContentScroll="True"
                                              VerticalScrollBarVisibility="Visible"
                                              HorizontalScrollBarVisibility="Disabled"
                                              Focusable="False">
                                    <ItemsPresenter/>
                                </ScrollViewer>
                            </ControlTemplate>
                        </ItemsControl.Template>
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <VirtualizingStackPanel Orientation="Vertical"/>
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border BorderBrush="{StaticResource BorderBrush}"
                                            BorderThickness="0,0,0,1"
                                            Padding="0,12">
                                        <!-- MinHeight keeps every row the same height, so the columns read
                                             as straight vertical lines down the list. -->
                                        <Grid MinHeight="44">
                                            <!-- Must stay identical to the header Grid above, minus its
                                                 trailing scrollbar-reserve column (the scrollbar already
                                                 takes that width out of this grid). -->
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="36"/>
                                                <ColumnDefinition Width="2.2*"/>
                                                <ColumnDefinition Width="1.0*"/>
                                                <ColumnDefinition Width="1.0*"/>
                                                <ColumnDefinition Width="2.4*"/>
                                            </Grid.ColumnDefinitions>

                                            <CheckBox Grid.Column="0"
                                                      IsChecked="{Binding IsSelected, Mode=TwoWay}"
                                                      VerticalAlignment="Center"/>

                                            <TextBlock Grid.Column="1"
                                                       Text="{Binding Name}"
                                                       Margin="0,0,16,0"
                                                       FontSize="13"
                                                       FontWeight="SemiBold"
                                                       Foreground="{StaticResource TextPrimaryBrush}"
                                                       TextTrimming="CharacterEllipsis"
                                                       VerticalAlignment="Center"
                                                       ToolTip="{Binding Name}"/>

                                            <TextBlock Grid.Column="2"
                                                       Text="{Binding AreaSqFt, StringFormat={}{0:N2}}"
                                                       Margin="0,0,16,0"
                                                       FontSize="13"
                                                       TextAlignment="Center"
                                                       Foreground="{StaticResource TextPrimaryBrush}"
                                                       VerticalAlignment="Center"/>

                                            <TextBlock Grid.Column="3"
                                                       Text="{Binding CeilingHeightFt, StringFormat={}{0:F2}}"
                                                       Margin="0,0,20,0"
                                                       FontSize="13"
                                                       TextAlignment="Center"
                                                       Foreground="{StaticResource TextPrimaryBrush}"
                                                       VerticalAlignment="Center"/>

                                            <!-- Per-row Family / Type override (item 5 + 7). The tab's
                                                 universal selection is this row's default; changing it here
                                                 overrides only this room. The Type list follows this row's
                                                 own Family via DeviceRoomItemViewModel's types resolver. -->
                                            <StackPanel Grid.Column="4" VerticalAlignment="Center" Margin="0,0,4,0">
                                                <ComboBox Style="{StaticResource CellComboBoxStyle}"
                                                          ItemsSource="{Binding AvailableFamilies}"
                                                          SelectedItem="{Binding SelectedFamily, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                          ToolTip="Device family for this room. Defaults to the tab selection above."/>
                                                <ComboBox Style="{StaticResource CellComboBoxStyle}"
                                                          Margin="0,4,0,0"
                                                          ItemsSource="{Binding AvailableTypes}"
                                                          SelectedItem="{Binding SelectedType, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                          ToolTip="Device type for this room. The list follows this row's family."/>
                                            </StackPanel>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                    <Border Grid.Row="4"
                            BorderBrush="{StaticResource BorderBrush}"
                            BorderThickness="0,1,0,0"
                            Padding="0,10,0,0"
                            Margin="0,10,0,0">
                        <TextBlock Text="{Binding RoomsSelectedSummary}"
                                   FontSize="12"
                                   Foreground="{StaticResource TextSecondaryBrush}"/>
                    </Border>
                </Grid>
            </Border>
        </Grid>

        <!-- ================= BOTTOM ACTIONS ================= -->
        <Grid Grid.Row="3" Margin="0,16,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <ctrl:InfoBanner Grid.Column="0">
                <StackPanel>
                    <TextBlock FontSize="12"
                               Foreground="{StaticResource AccentBrush}"
                               Text="Device placement backend is not yet implemented (UI-first slice)."/>
                    <TextBlock FontSize="12"
                               Foreground="{StaticResource AccentBrush}"
                               Margin="0,2,0,0"
                               Text="Room/level selection is shared and ready; the Place action is disabled until the NFPA-72 logic lands."/>
                </StackPanel>
            </ctrl:InfoBanner>

            <!-- Progress + cancel (item 3). Plumbed through IDevicePlacementExecutor so it works the moment
                 the device backend lands; with the placeholder executor there is nothing to report. -->
            <TextBlock Grid.Column="1"
                       Text="{Binding PlacementProgressText}"
                       FontSize="12"
                       Foreground="{StaticResource TextSecondaryBrush}"
                       MaxWidth="260"
                       TextTrimming="CharacterEllipsis"
                       VerticalAlignment="Center"
                       Margin="16,0,0,0"
                       ToolTip="{Binding PlacementProgressText}"/>

            <Button Grid.Column="2"
                    Style="{StaticResource OutlineButtonStyle}"
                    Command="{Binding CancelPlacementCommand}"
                    Content="Cancel"
                    Padding="14,10"
                    Margin="10,0,0,0"
                    Visibility="{Binding CanCancelPlacement, Converter={StaticResource BoolToVis}}"/>

            <Button Grid.Column="3"
                    Style="{StaticResource PrimaryButtonStyle}"
                    Command="{Binding PlaceDevicesCommand}"
                    Margin="16,0,0,0">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="&#x2295;" FontSize="14" Margin="0,0,8,0" VerticalAlignment="Center"/>
                    <TextBlock Text="Place Devices" VerticalAlignment="Center"/>
                </StackPanel>
            </Button>

            <Button Grid.Column="4"
                    Style="{StaticResource OutlineButtonStyle}"
                    Command="{Binding ResetCommand}"
                    Margin="10,0,0,0"
                    Padding="18,10">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="&#x21BB;" FontSize="13" Margin="0,0,8,0" VerticalAlignment="Center"/>
                    <TextBlock Text="Reset" VerticalAlignment="Center"/>
                </StackPanel>
            </Button>
        </Grid>
    </Grid>
</UserControl>
