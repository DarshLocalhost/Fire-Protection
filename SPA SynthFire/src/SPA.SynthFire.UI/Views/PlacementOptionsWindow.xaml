<Window x:Class="SPA.SynthFire.UI.Views.PlacementOptionsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="SPA SynthFire — Sprinkler Placement"
        Width="460" Height="380"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize"
        ShowInTaskbar="False">
    <Grid Margin="18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="Sprinkler Placement" FontSize="18" FontWeight="SemiBold"/>
        <TextBlock Grid.Row="1" Margin="0,4,0,16" TextWrapping="Wrap" Foreground="#666"
                   Text="Choose the sprinkler family, design standard and hazard classification. Layouts are computed to the standard's spacing and coverage limits."/>

        <TextBlock Grid.Row="2" Text="Sprinkler family / type" FontWeight="SemiBold"/>
        <ComboBox Grid.Row="3" x:Name="FamilyCombo" Margin="0,4,0,12" Height="28"
                  DisplayMemberPath="Label"/>

        <TextBlock Grid.Row="4" Text="Design standard" FontWeight="SemiBold"/>
        <ComboBox Grid.Row="5" x:Name="StandardCombo" Margin="0,4,0,12" Height="28"
                  DisplayMemberPath="DisplayName" SelectionChanged="StandardCombo_SelectionChanged"/>

        <TextBlock Grid.Row="6" Text="Hazard classification" FontWeight="SemiBold"/>
        <ComboBox Grid.Row="7" x:Name="HazardCombo" Margin="0,4,0,12" Height="28" VerticalAlignment="Top"
                  DisplayMemberPath="DisplayName"/>

        <StackPanel Grid.Row="9" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button x:Name="PlaceButton" Content="Place sprinklers" Width="130" Height="30" Margin="0,0,8,0"
                    IsDefault="True" Click="Place_Click"/>
            <Button Content="Cancel" Width="90" Height="30" IsCancel="True"/>
        </StackPanel>
    </Grid>
</Window>
