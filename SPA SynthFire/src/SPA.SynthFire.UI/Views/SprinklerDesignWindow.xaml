<Window x:Class="SPA.SynthFire.UI.Views.SprinklerDesignWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="SPA SynthFire — Sprinkler Design"
        Width="420" Height="540"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize"
        Background="{DynamicResource Surface}"
        Foreground="{DynamicResource Ink}"
        FontFamily="Segoe UI" FontSize="13"
        ShowInTaskbar="False">
    <Window.Resources>
        <ResourceDictionary Source="/SPA.SynthFire.UI;component/Themes/Styles.xaml"/>
    </Window.Resources>
    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="Sprinkler Design" Style="{StaticResource SectionHeader}"/>
        <TextBlock Grid.Row="1" Margin="0,6,0,20" Style="{StaticResource Caption}"
                   Text="Revit stays fully editable while this window is open. Choose a family and design criteria, then place."/>

        <TextBlock Grid.Row="2" Text="Sprinkler family / type" Style="{StaticResource FieldLabel}"/>
        <ComboBox Grid.Row="3" Margin="0,0,0,14" DisplayMemberPath="Label"
                  ItemsSource="{Binding Families}" SelectedItem="{Binding SelectedFamily}"/>

        <TextBlock Grid.Row="4" Text="Design standard" Style="{StaticResource FieldLabel}"/>
        <ComboBox Grid.Row="5" Margin="0,0,0,14" DisplayMemberPath="DisplayName"
                  ItemsSource="{Binding Standards}" SelectedItem="{Binding SelectedStandard}"/>

        <TextBlock Grid.Row="6" Text="Default hazard (for unclassified rooms)" Style="{StaticResource FieldLabel}"/>
        <ComboBox Grid.Row="7" Margin="0,0,0,6" DisplayMemberPath="DisplayName"
                  ItemsSource="{Binding Hazards}" SelectedItem="{Binding SelectedHazard}"/>
        <TextBlock Grid.Row="8" Margin="0,0,0,10" Style="{StaticResource Caption}" FontSize="11"
                   Text="Rooms tagged by the Hazard Classification tool use their own hazard. This applies only to rooms that were never classified."/>

        <StackPanel Grid.Row="9" Margin="0,4,0,0">
            <CheckBox Content="Clear previously placed SPA SynthFire heads first (redesign)"
                      IsChecked="{Binding ClearPrevious}"/>
            <CheckBox Content="Preview only — solve and report without modifying the model"
                      IsChecked="{Binding PreviewOnly}" Margin="0,10,0,0"/>
        </StackPanel>

        <Border Grid.Row="10" Style="{StaticResource Card}" Margin="0,16,0,0" VerticalAlignment="Top">
            <TextBlock Style="{StaticResource Caption}" Text="{Binding Status}"/>
        </Border>

        <Grid Grid.Row="11" Margin="0,16,0,0">
            <Button Content="View coverage plan" Width="150" HorizontalAlignment="Left"
                    Command="{Binding ViewPlanCommand}" Style="{StaticResource SecondaryButton}"/>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button x:Name="PlaceButton" Content="Place sprinklers" Width="130" Margin="0,0,8,0"
                        Command="{Binding PlaceCommand}" Style="{StaticResource PrimaryButton}"/>
                <Button Content="Close" Width="80" Click="Close_Click" Style="{StaticResource SecondaryButton}"/>
            </StackPanel>
        </Grid>
    </Grid>
</Window>
