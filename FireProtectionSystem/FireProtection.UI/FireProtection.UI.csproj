<Project Sdk="Microsoft.NET.Sdk">

	<!-- ========================================================= -->
	<!-- Common settings                                           -->
	<!-- ========================================================= -->

	<PropertyGroup>

		<Configurations>Debug;Release;Revit2024;Revit2025;Revit2026</Configurations>
		<Platforms>AnyCPU;x64</Platforms>

		<LangVersion>7.3</LangVersion>

		<Nullable>disable</Nullable>
		<ImplicitUsings>disable</ImplicitUsings>

		<UseWPF>true</UseWPF>

		<RootNamespace>FireProtection.UI</RootNamespace>
		<AssemblyName>FireProtection.UI</AssemblyName>

	</PropertyGroup>


	<!-- ========================================================= -->
	<!-- Revit 2024                                               -->
	<!-- ========================================================= -->

	<PropertyGroup Condition="'$(Configuration)' == 'Revit2024'">

		<TargetFramework>net48</TargetFramework>

		<OutputPath>bin\2024\</OutputPath>

		<DefineConstants>$(DefineConstants);REVIT_2024</DefineConstants>

		<PlatformTarget>x64</PlatformTarget>

	</PropertyGroup>


	<!-- ========================================================= -->
	<!-- Revit 2025                                               -->
	<!-- ========================================================= -->

	<PropertyGroup Condition="'$(Configuration)' == 'Revit2025'">

		<TargetFramework>net8.0-windows</TargetFramework>

		<OutputPath>bin\2025\</OutputPath>

		<DefineConstants>$(DefineConstants);REVIT_2025</DefineConstants>

		<PlatformTarget>x64</PlatformTarget>

	</PropertyGroup>


	<!-- ========================================================= -->
	<!-- Revit 2026                                               -->
	<!-- ========================================================= -->

	<PropertyGroup Condition="'$(Configuration)' == 'Revit2026'">

		<TargetFramework>net8.0-windows</TargetFramework>

		<OutputPath>bin\2026\</OutputPath>

		<DefineConstants>$(DefineConstants);REVIT_2026</DefineConstants>

		<PlatformTarget>x64</PlatformTarget>

	</PropertyGroup>


	<!-- ========================================================= -->
	<!-- Debug                                                     -->
	<!-- ========================================================= -->

	<PropertyGroup Condition="'$(Configuration)' == 'Debug'">

		<TargetFramework>net8.0-windows</TargetFramework>

		<PlatformTarget>x64</PlatformTarget>

	</PropertyGroup>


	<!-- ========================================================= -->
	<!-- Release                                                   -->
	<!-- ========================================================= -->

	<PropertyGroup Condition="'$(Configuration)' == 'Release'">

		<TargetFramework>net8.0-windows</TargetFramework>

		<PlatformTarget>x64</PlatformTarget>

	</PropertyGroup>

	<ItemGroup>
	  <PackageReference Include="Newtonsoft.Json" Version="13.0.4" />
	</ItemGroup>

	<ItemGroup>
	  <Folder Include="Models\Sprinklers\" />
	</ItemGroup>

</Project>