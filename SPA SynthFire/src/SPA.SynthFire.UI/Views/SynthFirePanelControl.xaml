<UserControl x:Class="SPA.SynthFire.UI.Views.SynthFirePanelControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="{DynamicResource Surface}"
             Foreground="{DynamicResource Ink}"
             FontFamily="Segoe UI" FontSize="13">
    <UserControl.Resources>
        <ResourceDictionary Source="/SPA.SynthFire.UI;component/Themes/Styles.xaml"/>
    </UserControl.Resources>
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="16">
            <TextBlock Text="SPA SynthFire" Style="{StaticResource SectionHeader}"/>
            <TextBlock Margin="0,6,0,16" Style="{StaticResource Caption}"
                       Text="Fire-protection design tools. Each opens beside the model; Revit stays editable."/>

            <TextBlock Text="Setup" Style="{StaticResource FieldLabel}"/>
            <Button Content="Settings &amp; design criteria" Margin="0,0,0,6" Tag="Settings"
                    Click="Tool_Click" Style="{StaticResource SecondaryButton}" HorizontalAlignment="Stretch"/>
            <Button Content="Room creation" Margin="0,0,0,6" Tag="RoomCreation"
                    Click="Tool_Click" Style="{StaticResource SecondaryButton}" HorizontalAlignment="Stretch"/>
            <Button Content="Hazard classification" Margin="0,0,0,16" Tag="Hazard"
                    Click="Tool_Click" Style="{StaticResource SecondaryButton}" HorizontalAlignment="Stretch"/>

            <TextBlock Text="Design" Style="{StaticResource FieldLabel}"/>
            <Button Content="Place sprinklers" Margin="0,0,0,6" Tag="PlaceSprinklers"
                    Click="Tool_Click" Style="{StaticResource PrimaryButton}" HorizontalAlignment="Stretch"/>
            <Button Content="Place detectors" Margin="0,0,0,16" Tag="PlaceDetectors"
                    Click="Tool_Click" Style="{StaticResource PrimaryButton}" HorizontalAlignment="Stretch"/>

            <TextBlock Text="Support" Style="{StaticResource FieldLabel}"/>
            <Button Content="Clear placed devices" Margin="0,0,0,16" Tag="ClearDevices"
                    Click="Tool_Click" Style="{StaticResource SecondaryButton}" HorizontalAlignment="Stretch"/>

            <Border Style="{StaticResource Card}">
                <TextBlock Style="{StaticResource Caption}" Text="{Binding Status, RelativeSource={RelativeSource AncestorType=UserControl}}"/>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
