<UserControl x:Class="FireProtection.UI.Views.Sprinklers.Collision.SprinklerCollisionView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:ctrl="clr-namespace:FireProtection.UI.Controls"
             mc:Ignorable="d" 
             d:DesignHeight="600" d:DesignWidth="900"
             FontFamily="Segoe UI">

    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/FireProtection.UI;component/Themes/Colors.xaml"/>
                <ResourceDictionary Source="/FireProtection.UI;component/Themes/Styles.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>

    <Grid Background="{DynamicResource BackgroundBrush}" Margin="12,8">
        <Grid.RowDefinitions>
            <!-- Review Header / Summary Card -->
            <RowDefinition Height="Auto"/>
            <!-- Data Grid of Selected Rooms -->
            <RowDefinition Height="*"/>
            <!-- Bottom Navigation / Action Bar -->
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Summary Banner / Card -->
        <Border Grid.Row="0"
                Style="{StaticResource CardBorder}"
                Padding="16,12"
                Margin="0,0,0,12">
            <DockPanel LastChildFill="False">
                <StackPanel DockPanel.Dock="Left" VerticalAlignment="Center">
                    <TextBlock Text="Final Review &amp; Placement"
                               FontSize="16"
                               FontWeight="SemiBold"
                               Foreground="{StaticResource TextPrimaryBrush}"/>
                    <TextBlock Text="{Binding SummaryText}"
                               FontSize="12"
                               Foreground="{StaticResource TextSecondaryBrush}"
                               Margin="0,4,0,0"/>
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- Selected Rooms Table -->
        <Border Grid.Row="1"
                Background="{DynamicResource SurfaceBrush}"
                BorderBrush="{StaticResource BorderBrush}"
                BorderThickness="1"
                CornerRadius="6">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- Table Header -->
                <Border Grid.Row="0"
                        Background="{StaticResource BackgroundOverlayBrush}"
                        BorderBrush="{StaticResource BorderBrush}"
                        BorderThickness="0,0,0,1"
                        Padding="16,10">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="2.2*"/>
                            <ColumnDefinition Width="1.2*"/>
                            <ColumnDefinition Width="0.9*"/>
                            <ColumnDefinition Width="1.1*"/>
                            <ColumnDefinition Width="2.2*"/>
                            <ColumnDefinition Width="0.9*"/>
                            <ColumnDefinition Width="0.9*"/>
                            <ColumnDefinition Width="0.9*"/>
                        </Grid.ColumnDefinitions>

                        <TextBlock Grid.Column="0" Text="ROOM NAME" Style="{StaticResource EyebrowText}"/>
                        <TextBlock Grid.Column="1" Text="LEVEL" Style="{StaticResource EyebrowText}"/>
                        <TextBlock Grid.Column="2" Text="AREA (SQ FT)" TextAlignment="Right" Style="{StaticResource EyebrowTextRight}"/>
                        <TextBlock Grid.Column="3" Text="HAZARD" Margin="8,0,0,0" Style="{StaticResource EyebrowText}"/>
                        <TextBlock Grid.Column="4" Text="SPRINKLER FAMILY / TYPE" Margin="8,0,0,0" Style="{StaticResource EyebrowText}"/>
                        <TextBlock Grid.Column="5" Text="CEILING" TextAlignment="Right" Style="{StaticResource EyebrowTextRight}"/>
                        <TextBlock Grid.Column="6" Text="SPACING" TextAlignment="Right" Style="{StaticResource EyebrowTextRight}"/>
                        <TextBlock Grid.Column="7" Text="WALL CLR" TextAlignment="Right" Style="{StaticResource EyebrowTextRight}"/>
                    </Grid>
                </Border>

                <!-- Rooms List -->
                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <ItemsControl ItemsSource="{Binding ReviewRooms}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border BorderBrush="{StaticResource DividerBrush}"
                                        BorderThickness="0,0,0,1"
                                        Padding="16,8">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="2.2*"/>
                                            <ColumnDefinition Width="1.2*"/>
                                            <ColumnDefinition Width="0.9*"/>
                                            <ColumnDefinition Width="1.1*"/>
                                            <ColumnDefinition Width="2.2*"/>
                                            <ColumnDefinition Width="0.9*"/>
                                            <ColumnDefinition Width="0.9*"/>
                                            <ColumnDefinition Width="0.9*"/>
                                        </Grid.ColumnDefinitions>

                                        <!-- Room Name & Number -->
                                        <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding RoomName}"
                                                       FontSize="13"
                                                       FontWeight="SemiBold"
                                                       Foreground="{StaticResource TextPrimaryBrush}"
                                                       TextTrimming="CharacterEllipsis"/>
                                            <TextBlock Text="{Binding RoomNumber, StringFormat='No. {0}'}"
                                                       FontSize="11"
                                                       Foreground="{StaticResource TextMutedBrush}"
                                                       Visibility="{Binding RoomNumber, Converter={StaticResource StringToVis}}"/>
                                        </StackPanel>

                                        <!-- Level -->
                                        <TextBlock Grid.Column="1"
                                                   Text="{Binding LevelName}"
                                                   VerticalAlignment="Center"
                                                   FontSize="12.5"
                                                   Foreground="{StaticResource TextSecondaryBrush}"
                                                   TextTrimming="CharacterEllipsis"/>

                                        <!-- Area -->
                                        <TextBlock Grid.Column="2"
                                                   Text="{Binding AreaSqFt, StringFormat={}{0:N1}}"
                                                   VerticalAlignment="Center"
                                                   TextAlignment="Right"
                                                   FontSize="12.5"
                                                   Style="{StaticResource DataNumeric}"/>

                                        <!-- Hazard -->
                                        <Border Grid.Column="3"
                                                Margin="8,0,0,0"
                                                HorizontalAlignment="Left"
                                                VerticalAlignment="Center"
                                                Background="{StaticResource BackgroundOverlayBrush}"
                                                CornerRadius="3"
                                                Padding="6,2">
                                            <TextBlock Text="{Binding HazardClass}"
                                                       FontSize="11.5"
                                                       FontWeight="SemiBold"
                                                       Foreground="{StaticResource TextPrimaryBrush}"/>
                                        </Border>

                                        <!-- Family / Type -->
                                        <StackPanel Grid.Column="4" Margin="8,0,0,0" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding FamilyName}"
                                                       FontSize="12"
                                                       FontWeight="Medium"
                                                       Foreground="{StaticResource TextPrimaryBrush}"
                                                       TextTrimming="CharacterEllipsis"/>
                                            <TextBlock Text="{Binding TypeName}"
                                                       FontSize="11"
                                                       Foreground="{StaticResource TextMutedBrush}"
                                                       TextTrimming="CharacterEllipsis"/>
                                        </StackPanel>

                                        <!-- Ceiling -->
                                        <TextBlock Grid.Column="5"
                                                   Text="{Binding CeilingHeight}"
                                                   VerticalAlignment="Center"
                                                   TextAlignment="Right"
                                                   FontSize="12"
                                                   Style="{StaticResource DataNumeric}"/>

                                        <!-- Spacing -->
                                        <TextBlock Grid.Column="6"
                                                   Text="{Binding SpacingFt, StringFormat={}{0:F2} ft}"
                                                   VerticalAlignment="Center"
                                                   TextAlignment="Right"
                                                   FontSize="12"
                                                   Style="{StaticResource DataNumeric}"/>

                                        <!-- Wall Clearance -->
                                        <TextBlock Grid.Column="7"
                                                   Text="{Binding ClearanceFt, StringFormat={}{0:F2} ft}"
                                                   VerticalAlignment="Center"
                                                   TextAlignment="Right"
                                                   FontSize="12"
                                                   Style="{StaticResource DataNumeric}"/>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </Grid>
        </Border>

        <!-- Bottom Navigation & Action Bar -->
        <Grid Grid.Row="2" Margin="0,14,0,4">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <!-- Bottom Left: Previous / Back button -->
            <Button Grid.Column="0"
                    Style="{StaticResource OutlineButtonStyle}"
                    Command="{Binding GoBackCommand}"
                    Padding="18,9">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="&#x2190; " FontSize="14" Margin="0,0,6,0" VerticalAlignment="Center"/>
                    <TextBlock Text="Previous" VerticalAlignment="Center"/>
                </StackPanel>
            </Button>

            <!-- Middle: Progress & Status reporting -->
            <TextBlock Grid.Column="1"
                       Text="{Binding PlacementProgressText}"
                       Style="{StaticResource DataMuted}"
                       FontSize="11.5"
                       MaxWidth="350"
                       TextTrimming="CharacterEllipsis"
                       VerticalAlignment="Center"
                       HorizontalAlignment="Center"
                       Margin="16,0,16,0"
                       ToolTip="{Binding PlacementProgressText}"/>

            <!-- Bottom Right: Cancel & Place Sprinklers -->
            <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                <CheckBox Content="Ignore Obstacles (Place all calculated)"
                          IsChecked="{Binding IgnoreObstacles, Mode=TwoWay}"
                          Margin="0,0,16,0"
                          VerticalAlignment="Center"
                          FontWeight="Medium"
                          ToolTip="When unchecked (default), sprinklers that collide directly with obstacle bounding boxes are skipped. When checked, all calculated sprinklers are placed regardless of obstacles."/>

                <Button Style="{StaticResource OutlineButtonStyle}"
                        Command="{Binding CancelPlacementCommand}"
                        Content="Cancel Placement"
                        Padding="14,9"
                        Margin="0,0,10,0"
                        Visibility="{Binding CanCancelPlacement, Converter={StaticResource BoolToVis}}"/>

                <Button Style="{StaticResource OutlineButtonStyle}"
                        Command="{Binding CancelCommand}"
                        Content="Cancel"
                        Padding="18,9"
                        Margin="0,0,10,0"/>

                <Button Style="{StaticResource PrimaryButtonStyle}"
                        Command="{Binding PlaceSprinklersCommand}"
                        Padding="22,9">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#x2295;" FontSize="14" Margin="0,0,8,0" VerticalAlignment="Center"/>
                        <TextBlock Text="Place Sprinklers" FontWeight="SemiBold" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>
            </StackPanel>
        </Grid>
    </Grid>
</UserControl>
