<UserControl x:Class="FireProtection.UI.Views.SmokeDetectors.SmokeDetectorView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:vDevices="clr-namespace:FireProtection.UI.Views.Devices"
             mc:Ignorable="d"
             d:DesignHeight="820" d:DesignWidth="1280">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/FireProtection.UI;component/Themes/Colors.xaml"/>
                <ResourceDictionary Source="/FireProtection.UI;component/Themes/Styles.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>

    <!-- 16px side inset matches the nested DevicePlacementView, so this card's edges line up with
         the cards below it. No bottom margin: row 1 is the 12px gutter. -->
    <Grid Margin="16,16,16,0">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="12"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Device-specific parameters. Detector Type, Mount and Ceiling Slope come from the catalog
             row for the selected family/type, so they read as facts about the device (plain text);
             each one only shows its editable picker when the catalog cannot derive it. -->
        <Border Grid.Row="0"
                Background="{StaticResource SurfaceBrush}"
                BorderBrush="{StaticResource BorderBrush}"
                BorderThickness="1"
                CornerRadius="6"
                Padding="18">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <WrapPanel Grid.Row="0">
                    <StackPanel Orientation="Horizontal" Margin="0,0,36,6">
                        <TextBlock Text="Detector Type" Style="{StaticResource FieldLabel}"/>
                        <ComboBox Width="220" ItemsSource="{Binding DetectorTypeOptions}"
                                  SelectedItem="{Binding DetectorType, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                  Style="{StaticResource StandardComboBoxStyle}"
                                  Visibility="{Binding ShowDetectorTypePicker, Converter={StaticResource BoolToVis}}"/>
                        <TextBlock Text="{Binding DerivedDetectorType}"
                                   Style="{StaticResource DataText}"
                                   FontSize="12.5"
                                   MinHeight="32"
                                   VerticalAlignment="Center"
                                   MinWidth="120"
                                   Visibility="{Binding ShowDetectorTypePicker, Converter={StaticResource InverseBoolToVis}}"
                                   ToolTip="From the catalog row for the selected family/type."/>
                    </StackPanel>

                    <StackPanel Orientation="Horizontal" Margin="0,0,36,6">
                        <TextBlock Text="Mount" Style="{StaticResource FieldLabel}"/>
                        <ComboBox Width="220" ItemsSource="{Binding CeilingMountOptions}"
                                  SelectedItem="{Binding CeilingMount, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                  Style="{StaticResource StandardComboBoxStyle}"
                                  Visibility="{Binding ShowMountPicker, Converter={StaticResource BoolToVis}}"/>
                        <TextBlock Text="{Binding DerivedMount}"
                                   Style="{StaticResource DataText}"
                                   FontSize="12.5"
                                   MinHeight="32"
                                   VerticalAlignment="Center"
                                   MinWidth="120"
                                   Visibility="{Binding ShowMountPicker, Converter={StaticResource InverseBoolToVis}}"
                                   ToolTip="From the catalog row for the selected family/type."/>
                    </StackPanel>

                    <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                        <TextBlock Text="Ceiling Slope" Style="{StaticResource FieldLabel}"/>
                        <ComboBox Width="220" ItemsSource="{Binding CeilingSlopeOptions}"
                                  SelectedItem="{Binding CeilingSlope, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                  Style="{StaticResource StandardComboBoxStyle}"
                                  Visibility="{Binding ShowCeilingSlopePicker, Converter={StaticResource BoolToVis}}"/>
                        <TextBlock Text="{Binding DerivedCeilingSlope}"
                                   Style="{StaticResource DataText}"
                                   FontSize="12.5"
                                   MinHeight="32"
                                   VerticalAlignment="Center"
                                   MinWidth="120"
                                   Visibility="{Binding ShowCeilingSlopePicker, Converter={StaticResource InverseBoolToVis}}"
                                   ToolTip="From the catalog row for the selected family/type."/>
                    </StackPanel>
                </WrapPanel>

                <TextBlock Grid.Row="1"
                           Margin="0,10,0,0"
                           FontSize="12"
                           TextWrapping="Wrap"
                           Foreground="{StaticResource UndeterminedBrush}"
                           Text="{Binding CatalogStatusMessage}">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Setter Property="Visibility" Value="Collapsed"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsCatalogLoaded}" Value="False">
                                    <Setter Property="Visibility" Value="Visible"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
            </Grid>
        </Border>

        <!-- Shared device placement workflow -->
        <vDevices:DevicePlacementView Grid.Row="2"/>
    </Grid>
</UserControl>
