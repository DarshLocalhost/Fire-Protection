<UserControl x:Class="FireProtection.UI.Views.Devices.DevicePlacementView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:vmDevices="clr-namespace:FireProtection.UI.ViewModels.Devices"
             xmlns:ctrl="clr-namespace:FireProtection.UI.Controls"
             mc:Ignorable="d"
             d:DesignHeight="820" d:DesignWidth="1280"
             Background="Transparent"
             FontFamily="Segoe UI">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/FireProtection.UI;component/Themes/Colors.xaml"/>
                <ResourceDictionary Source="/FireProtection.UI;component/Themes/Styles.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>

    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="16"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- ================= TOP: DEVICE CONFIGURATION ================= -->
        <Border Grid.Row="0"
                Background="{StaticResource SurfaceBrush}"
                BorderBrush="{StaticResource BorderBrush}"
                BorderThickness="1"
                CornerRadius="8">
            <Grid Margin="18">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="12"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0"
                           Text="{Binding DeviceDisplayName}"
                           FontSize="15"
                           FontWeight="SemiBold"
                           Foreground="{StaticResource TextPrimaryBrush}"/>

                <Grid Grid.Row="2">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="170"/>
                        <ColumnDefinition Width="320"/>
                        <ColumnDefinition Width="32"/>
                        <ColumnDefinition Width="170"/>
                        <ColumnDefinition Width="320"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <TextBlock Grid.Column="0"
                               Text="Device Family"
                               FontSize="13"
                               FontWeight="SemiBold"
                               Foreground="{StaticResource TextPrimaryBrush}"
                               VerticalAlignment="Center"/>

                    <ComboBox Grid.Column="1"
                              Style="{StaticResource StandardComboBoxStyle}"
                              ItemsSource="{Binding DeviceFamilies}"
                              SelectedItem="{Binding SelectedDeviceFamily, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                              DisplayMemberPath="FamilyName"/>

                    <TextBlock Grid.Column="3"
                               Text="Device Type"
                               FontSize="13"
                               FontWeight="SemiBold"
                               Foreground="{StaticResource TextPrimaryBrush}"
                               VerticalAlignment="Center"/>

                    <ComboBox Grid.Column="4"
                              Style="{StaticResource StandardComboBoxStyle}"
                              ItemsSource="{Binding DeviceTypes}"
                              SelectedItem="{Binding SelectedDeviceType, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                              DisplayMemberPath="TypeName"
                              IsEnabled="{Binding IsDeviceFamilySelected}"/>
                </Grid>
            </Grid>
        </Border>

        <!-- ================= MAIN CONTENT ================= -->
        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="300"/>
                <ColumnDefinition Width="16"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- ================= LEFT: LEVELS ================= -->
            <Border Grid.Row="0" Grid.Column="0"
                    Background="{StaticResource SurfaceBrush}"
                    BorderBrush="{StaticResource BorderBrush}"
                    BorderThickness="1"
                    CornerRadius="8">

                <Grid Margin="14">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <TextBlock Text="Level Selection"
                                   FontSize="15"
                                   FontWeight="SemiBold"
                                   Foreground="{StaticResource TextPrimaryBrush}"
                                   VerticalAlignment="Center"/>

                        <Button Grid.Column="1"
                                Style="{StaticResource OutlineButtonStyle}"
                                Command="{Binding ToggleHideUnselectedLevelsCommand}">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#x1F441;" FontSize="12" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                <TextBlock VerticalAlignment="Center">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Text" Value="Hide Unselected"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding HideUnselectedLevels}" Value="True">
                                                    <Setter Property="Text" Value="Show All"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </StackPanel>
                        </Button>
                    </Grid>

                    <ctrl:SearchBox Grid.Row="1"
                                    Margin="0,12,0,10"
                                    Text="{Binding LevelSearchText, UpdateSourceTrigger=PropertyChanged}"
                                    Placeholder="Search levels..."/>

                    <Grid Grid.Row="2" Margin="0,0,0,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="8"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="8"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <CheckBox Grid.Column="0"
                                  Content="Show levels with rooms only"
                                  IsChecked="{Binding ShowLevelsWithRoomsOnly, Mode=TwoWay}"
                                  VerticalAlignment="Center"
                                  Foreground="{StaticResource TextSecondaryBrush}"
                                  FontSize="12"/>

                        <Button Grid.Column="3"
                                Grid.ColumnSpan="3"
                                Style="{StaticResource OutlineButtonStyle}"
                                Content="{Binding LevelSelectionToggleLabel}"
                                Command="{Binding ToggleSelectAllLevelsCommand}"/>
                    </Grid>

                    <ListBox Grid.Row="3"
                             ItemsSource="{Binding LevelsView}"
                             Background="Transparent"
                             BorderThickness="0"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                             ItemContainerStyle="{StaticResource LevelListBoxItemStyle}">

                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Grid Margin="12,10">
                                    <Grid.Style>
                                        <Style TargetType="Grid">
                                            <Setter Property="Opacity" Value="1"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding HasRooms}" Value="False">
                                                    <Setter Property="Opacity" Value="0.5"/>
                                                    <Setter Property="ToolTip"
                                                            Value="This level has no rooms and cannot be selected for placement."/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Grid.Style>

                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>

                                    <CheckBox Grid.Column="0"
                                              IsChecked="{Binding IsSelected, Mode=TwoWay}"
                                              IsEnabled="{Binding HasRooms}"
                                              VerticalAlignment="Center"
                                              Margin="0,0,10,0"/>

                                    <StackPanel Grid.Column="1">
                                        <TextBlock Text="{Binding Name}"
                                                   FontSize="14"
                                                   FontWeight="SemiBold"
                                                   Foreground="{StaticResource TextPrimaryBrush}"/>
                                        <TextBlock FontSize="12"
                                                   Foreground="{StaticResource TextSecondaryBrush}"
                                                   Margin="0,2,0,0">
                                            <Run Text="Elev."/>
                                            <Run Text="{Binding ElevationFt,Mode=OneWay, StringFormat={}{0:F2} ft}"/>
                                        </TextBlock>
                                    </StackPanel>

                                    <TextBlock Grid.Column="2"
                                               VerticalAlignment="Center"
                                               FontSize="13"
                                               FontWeight="SemiBold"
                                               Foreground="{StaticResource TextSecondaryBrush}">
                                        <Run Text="{Binding SelectedRoomCount, Mode=OneWay}"/>
                                        <Run Text="/"/>
                                        <Run Text="{Binding TotalRoomCount, Mode=OneWay}"/>
                                    </TextBlock>
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>

                    <Border Grid.Row="4"
                            BorderBrush="{StaticResource BorderBrush}"
                            BorderThickness="0,1,0,0"
                            Padding="0,10,0,0"
                            Margin="0,10,0,0">
                        <TextBlock Text="{Binding SelectedLevelSummary}"
                                   FontSize="12"
                                   Foreground="{StaticResource TextSecondaryBrush}"/>
                    </Border>
                </Grid>
            </Border>

            <!-- ================= RIGHT: ROOMS ================= -->
            <Border Grid.Row="0" Grid.Column="2"
                    Background="{StaticResource SurfaceBrush}"
                    BorderBrush="{StaticResource BorderBrush}"
                    BorderThickness="1"
                    CornerRadius="8">

                <Grid Margin="18">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0" VerticalAlignment="Center">
                            <TextBlock Text="{Binding RoomsHeader}"
                                       FontSize="18"
                                       FontWeight="SemiBold"
                                       Foreground="{StaticResource TextPrimaryBrush}"/>
                            <TextBlock Text="{Binding RoomsFoundText}"
                                       FontSize="12"
                                       Foreground="{StaticResource TextSecondaryBrush}"
                                       Margin="0,4,0,0"/>
                        </StackPanel>

                        <ctrl:SearchBox Grid.Column="1"
                                        Width="320" Margin="12,0"
                                        Text="{Binding RoomSearchText, UpdateSourceTrigger=PropertyChanged}"
                                        Placeholder="Search rooms by name or number..."/>

                        <Button Grid.Column="2"
                                Style="{StaticResource OutlineButtonStyle}"
                                Command="{Binding ToggleHideUnselectedRoomsCommand}">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#x1F441;" FontSize="12" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                <TextBlock VerticalAlignment="Center">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Text" Value="Hide Unselected"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding HideUnselectedRooms}" Value="True">
                                                    <Setter Property="Text" Value="Show All"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </StackPanel>
                        </Button>
                    </Grid>

                    <Grid Grid.Row="1" Margin="0,12,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <CheckBox Grid.Column="0"
                                  Content="Show eligible rooms only"
                                  IsChecked="{Binding ShowEligibleRoomsOnly, Mode=TwoWay}"
                                  VerticalAlignment="Center"
                                  Foreground="{StaticResource TextSecondaryBrush}"
                                  FontSize="12"
                                  Margin="0,0,16,0"/>

                        <Button Grid.Column="1"
                                Style="{StaticResource OutlineButtonStyle}"
                                Content="{Binding RoomSelectionToggleLabel}"
                                Command="{Binding ToggleSelectAllRoomsCommand}"
                                HorizontalAlignment="Right"/>
                    </Grid>

                    <Border Grid.Row="2"
                            BorderBrush="{StaticResource BorderBrush}"
                            BorderThickness="0,1,0,1"
                            Padding="0,10"
                            Margin="0,12,0,0">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="36"/>
                                <ColumnDefinition Width="2.0*"/>
                                <ColumnDefinition Width="1.1*"/>
                                <ColumnDefinition Width="1.6*"/>
                                <ColumnDefinition Width="1.6*"/>
                            </Grid.ColumnDefinitions>

                            <CheckBox Grid.Column="0" IsEnabled="False"/>
                            <TextBlock Grid.Column="1" Text="Room Name" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource TextSecondaryBrush}"/>
                            <TextBlock Grid.Column="2" Text="Area (sq ft)" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource TextSecondaryBrush}"/>
                            <TextBlock Grid.Column="3" Text="Ceiling Height (ft)" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource TextSecondaryBrush}"/>
                            <TextBlock Grid.Column="4" Text="Eligibility" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource TextSecondaryBrush}"/>
                        </Grid>
                    </Border>

                    <ScrollViewer Grid.Row="3" VerticalScrollBarVisibility="Auto">
                        <ItemsControl ItemsSource="{Binding RoomsView}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border BorderBrush="{StaticResource BorderBrush}"
                                            BorderThickness="0,0,0,1"
                                            Padding="0,12">
                                        <Border.Style>
                                            <Style TargetType="Border">
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsEligible}" Value="False">
                                                        <Setter Property="Opacity" Value="0.5"/>
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding IsUndetermined}" Value="True">
                                                        <Setter Property="BorderBrush" Value="{StaticResource UndeterminedBrush}"/>
                                                        <Setter Property="BorderThickness" Value="0,0,0,2"/>
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding IsBlocked}" Value="True">
                                                        <Setter Property="BorderBrush" Value="{StaticResource BlockedBrush}"/>
                                                        <Setter Property="BorderThickness" Value="0,0,0,2"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Border.Style>
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="36"/>
                                                <ColumnDefinition Width="2.0*"/>
                                                <ColumnDefinition Width="1.1*"/>
                                                <ColumnDefinition Width="1.6*"/>
                                                <ColumnDefinition Width="1.6*"/>
                                            </Grid.ColumnDefinitions>

                                            <CheckBox Grid.Column="0"
                                                      IsChecked="{Binding IsSelected, Mode=TwoWay}"
                                                      IsEnabled="{Binding IsEligible}"
                                                      VerticalAlignment="Center"
                                                      ToolTip="{Binding EligibilityReason}"/>

                                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                <TextBlock Text="{Binding Name}"
                                                           FontSize="13"
                                                           FontWeight="SemiBold"
                                                           Foreground="{StaticResource TextPrimaryBrush}"
                                                           TextTrimming="CharacterEllipsis"/>
                                                <TextBlock FontSize="11"
                                                           Margin="0,2,0,0"
                                                           TextTrimming="CharacterEllipsis">
                                                    <TextBlock.Style>
                                                        <Style TargetType="TextBlock">
                                                            <Setter Property="Visibility" Value="Collapsed"/>
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding IsEligible}" Value="False">
                                                                    <Setter Property="Visibility" Value="Visible"/>
                                                                </DataTrigger>
                                                                <DataTrigger Binding="{Binding IsBlocked}" Value="True">
                                                                    <Setter Property="Foreground" Value="{StaticResource BlockedBrush}"/>
                                                                </DataTrigger>
                                                                <DataTrigger Binding="{Binding IsUndetermined}" Value="True">
                                                                    <Setter Property="Foreground" Value="{StaticResource UndeterminedBrush}"/>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </TextBlock.Style>
                                                    <Run Text="{Binding EligibilityState, Mode=OneWay}"
                                                         FontWeight="Bold"/>
                                                    <Run Text=" &#x2014; "/>
                                                    <Run Text="{Binding EligibilityReason, Mode=OneWay}"/>
                                                </TextBlock>
                                            </StackPanel>

                                            <TextBlock Grid.Column="2"
                                                       Text="{Binding AreaSqFt, StringFormat={}{0:N2}}"
                                                       FontSize="13"
                                                       Foreground="{StaticResource TextPrimaryBrush}"
                                                       VerticalAlignment="Center"/>

                                            <TextBlock Grid.Column="3"
                                                       Text="{Binding CeilingHeightFt, StringFormat={}{0:F2}}"
                                                       FontSize="13"
                                                       Foreground="{StaticResource TextPrimaryBrush}"
                                                       VerticalAlignment="Center"/>

                                            <TextBlock Grid.Column="4"
                                                       Text="{Binding EligibilityState, Mode=OneWay}"
                                                       FontSize="12"
                                                       FontWeight="SemiBold"
                                                       Foreground="{StaticResource TextSecondaryBrush}"
                                                       VerticalAlignment="Center"/>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>

                    <Border Grid.Row="4"
                            BorderBrush="{StaticResource BorderBrush}"
                            BorderThickness="0,1,0,0"
                            Padding="0,10,0,0"
                            Margin="0,10,0,0">
                        <TextBlock Text="{Binding RoomsSelectedSummary}"
                                   FontSize="12"
                                   Foreground="{StaticResource TextSecondaryBrush}"/>
                    </Border>
                </Grid>
            </Border>
        </Grid>

        <!-- ================= BOTTOM ACTIONS ================= -->
        <Grid Grid.Row="3" Margin="0,16,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <ctrl:InfoBanner Grid.Column="0">
                <StackPanel>
                    <TextBlock FontSize="12"
                               Foreground="{StaticResource AccentBrush}"
                               Text="Device placement backend is not yet implemented (UI-first slice)."/>
                    <TextBlock FontSize="12"
                               Foreground="{StaticResource AccentBrush}"
                               Margin="0,2,0,0"
                               Text="Room/level selection is shared and ready; the Place action is disabled until the NFPA-72 logic lands."/>
                </StackPanel>
            </ctrl:InfoBanner>

            <Button Grid.Column="1"
                    Style="{StaticResource PrimaryButtonStyle}"
                    Command="{Binding PlaceDevicesCommand}"
                    Margin="16,0,0,0">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="&#x2295;" FontSize="14" Margin="0,0,8,0" VerticalAlignment="Center"/>
                    <TextBlock Text="Place Devices" VerticalAlignment="Center"/>
                </StackPanel>
            </Button>

            <Button Grid.Column="2"
                    Style="{StaticResource OutlineButtonStyle}"
                    Command="{Binding ResetCommand}"
                    Margin="10,0,0,0"
                    Padding="18,10">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="&#x21BB;" FontSize="13" Margin="0,0,8,0" VerticalAlignment="Center"/>
                    <TextBlock Text="Reset" VerticalAlignment="Center"/>
                </StackPanel>
            </Button>
        </Grid>
    </Grid>
</UserControl>
