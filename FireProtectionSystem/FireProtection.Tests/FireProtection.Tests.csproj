<Project Sdk="Microsoft.NET.Sdk">

  <!-- The test harness is Revit-free (it exercises the calculation layer only), but it
       references FireProtection.Backend, whose target framework follows the Revit
       configuration. Without a matching per-configuration TFM below, adding this project to
       the solution breaks the Revit2024 build: a net8.0-windows test assembly cannot
       reference the net48 Backend that Revit2024 produces. Mirroring the Backend/UI matrix
       keeps the test project buildable — and therefore runnable — under every configuration. -->
  <PropertyGroup>
    <Configurations>Debug;Release;Revit2024;Revit2025;Revit2026</Configurations>
    <Platforms>AnyCPU;x64</Platforms>
  </PropertyGroup>

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <LangVersion>7.3</LangVersion>
    <AssemblyName>FireProtection.Tests</AssemblyName>
    <RootNamespace>FireProtection.Tests</RootNamespace>
    <CopyLocalLockFileAssemblies>true</CopyLocalLockFileAssemblies>
    <PlatformTarget>x64</PlatformTarget>
  </PropertyGroup>

  <PropertyGroup Condition="'$(Configuration)'=='Revit2024'">
    <TargetFramework>net48</TargetFramework>
    <DefineConstants>$(DefineConstants);REVIT_2024</DefineConstants>
  </PropertyGroup>

  <PropertyGroup Condition="'$(Configuration)'=='Revit2025'">
    <TargetFramework>net8.0-windows</TargetFramework>
    <DefineConstants>$(DefineConstants);REVIT_2025</DefineConstants>
  </PropertyGroup>

  <PropertyGroup Condition="'$(Configuration)'=='Revit2026'">
    <TargetFramework>net8.0-windows</TargetFramework>
    <DefineConstants>$(DefineConstants);REVIT_2026</DefineConstants>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\FireProtection.Backend\FireProtection.Backend.csproj" />
    <ProjectReference Include="..\FireProtection.UI\FireProtection.UI.csproj" />
  </ItemGroup>

</Project>
