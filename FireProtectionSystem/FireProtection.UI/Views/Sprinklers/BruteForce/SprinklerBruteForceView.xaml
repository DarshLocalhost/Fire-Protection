<UserControl x:Class="FireProtection.UI.Views.Sprinklers.BruteForce.SprinklerBruteForceView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:conv="clr-namespace:FireProtection.UI.Views.Sprinklers.BruteForce.Converters"
             xmlns:ctrl="clr-namespace:FireProtection.UI.Controls"
             mc:Ignorable="d"
             d:DesignHeight="820" d:DesignWidth="1280"
             Background="Transparent"
             FontFamily="Segoe UI">

    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/FireProtection.UI;component/Themes/Colors.xaml"/>
                <ResourceDictionary Source="/FireProtection.UI;component/Themes/Styles.xaml"/>
            </ResourceDictionary.MergedDictionaries>

            <!-- View-specific converters -->
            <conv:HazardClassToBrushConverter x:Key="HazardBackgroundConverter"/>
            <conv:HazardClassToBrushConverter x:Key="HazardForegroundConverter" ReturnForeground="True"/>

        <!-- Hazard-class ComboBox style (view-specific due to converter binding) -->
        <Style x:Key="HazardComboBoxStyle" TargetType="ComboBox">
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Height" Value="26"/>
            <Setter Property="MinWidth" Value="80"/>
            <Setter Property="HorizontalAlignment" Value="Left"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Padding" Value="8,0"/>
            <Setter Property="Background"
                    Value="{Binding SelectedHazardClass, Converter={StaticResource HazardBackgroundConverter}}"/>
            <Setter Property="Foreground"
                    Value="{Binding SelectedHazardClass, Converter={StaticResource HazardForegroundConverter}}"/>
            <Setter Property="BorderThickness" Value="0"/>
        </Style>
        </ResourceDictionary>
    </UserControl.Resources>

    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="16"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- ================= TOP: SPRINKLER CONFIGURATION ================= -->
        <Border Grid.Row="0"
                Style="{StaticResource CardBorder}">
            <Grid Margin="18,14">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="12"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <StackPanel Grid.Row="0" Orientation="Horizontal">
                    <Rectangle Width="3" Height="14"
                               Fill="{StaticResource BrandBrush}"
                               Margin="0,0,10,0"
                               VerticalAlignment="Center"/>
                    <TextBlock Text="SPRINKLER CONFIGURATION"
                               Style="{StaticResource EyebrowText}"/>
                </StackPanel>

                <Grid Grid.Row="2">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="170"/>
                        <ColumnDefinition Width="320"/>
                        <ColumnDefinition Width="32"/>
                        <ColumnDefinition Width="170"/>
                        <ColumnDefinition Width="320"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <TextBlock Grid.Column="0"
                               Text="Sprinkler Family"
                               FontSize="13"
                               FontWeight="SemiBold"
                               Foreground="{StaticResource TextPrimaryBrush}"
                               VerticalAlignment="Center"/>

                    <ComboBox Grid.Column="1"
                              Style="{StaticResource StandardComboBoxStyle}"
                              ItemsSource="{Binding SprinklerFamilies}"
                              SelectedItem="{Binding SelectedSprinklerFamily, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                              DisplayMemberPath="FamilyName"/>

                    <TextBlock Grid.Column="3"
                               Text="Sprinkler Type"
                               FontSize="13"
                               FontWeight="SemiBold"
                               Foreground="{StaticResource TextPrimaryBrush}"
                               VerticalAlignment="Center"/>

                    <ComboBox Grid.Column="4"
                              Style="{StaticResource StandardComboBoxStyle}"
                              ItemsSource="{Binding SprinklerTypes}"
                              SelectedItem="{Binding SelectedSprinklerType, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                              DisplayMemberPath="TypeName"
                              IsEnabled="{Binding IsSprinklerFamilySelected}"/>
                </Grid>
            </Grid>
        </Border>

        <!-- ================= MAIN CONTENT ================= -->
        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="300"/>
                <ColumnDefinition Width="16"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- ================= LEFT: LEVELS ================= -->
            <Border Grid.Row="0" Grid.Column="0"
                    Style="{StaticResource CardBorder}">

                <Grid Margin="14">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel Orientation="Horizontal">
                            <Rectangle Width="3" Height="14"
                                       Fill="{StaticResource BrassBrush}"
                                       Margin="0,0,10,0"
                                       VerticalAlignment="Center"/>
                            <TextBlock Text="LEVELS"
                                       Style="{StaticResource EyebrowText}"/>
                        </StackPanel>

                        <Button Grid.Column="1"
                                Style="{StaticResource OutlineButtonStyle}"
                                Command="{Binding ToggleHideUnselectedLevelsCommand}"
                                Padding="10,5">
                            <TextBlock FontSize="11.5" VerticalAlignment="Center">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Text" Value="Hide unselected"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding HideUnselectedLevels}" Value="True">
                                                <Setter Property="Text" Value="Show all"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </Button>
                    </Grid>

                    <ctrl:SearchBox Grid.Row="1"
                                    Margin="0,12,0,10"
                                    Text="{Binding LevelSearchText, UpdateSourceTrigger=PropertyChanged}"
                                    Placeholder="Search levels..."/>

                    <Grid Grid.Row="2" Margin="0,0,0,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="8"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="8"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <CheckBox Grid.Column="0"
                                  Content="Levels with rooms only"
                                  IsChecked="{Binding ShowLevelsWithRoomsOnly, Mode=TwoWay}"
                                  VerticalAlignment="Center"
                                  Foreground="{StaticResource TextSecondaryBrush}"
                                  FontSize="12"/>

                        <Button Grid.Column="3"
                                Grid.ColumnSpan="3"
                                Style="{StaticResource OutlineButtonStyle}"
                                Content="{Binding LevelSelectionToggleLabel}"
                                Command="{Binding ToggleSelectAllLevelsCommand}"/>
                    </Grid>

                    <ListBox Grid.Row="3"
                             ItemsSource="{Binding LevelsView}"
                             Background="Transparent"
                             BorderThickness="0"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                             ItemContainerStyle="{StaticResource LevelListBoxItemStyle}">

                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Grid Margin="12,9">
                                    <Grid.Style>
                                        <Style TargetType="Grid">
                                            <Setter Property="Opacity" Value="1"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding HasRooms}" Value="False">
                                                    <Setter Property="Opacity" Value="0.45"/>
                                                    <Setter Property="ToolTip"
                                                            Value="This level has no rooms and cannot be selected for sprinkler placement."/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Grid.Style>

                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>

                                    <CheckBox Grid.Column="0"
                                              IsChecked="{Binding IsSelected, Mode=TwoWay}"
                                              IsEnabled="{Binding HasRooms}"
                                              VerticalAlignment="Center"
                                              Margin="0,0,10,0"/>

                                    <StackPanel Grid.Column="1">
                                        <TextBlock Text="{Binding Name}"
                                                   FontSize="13"
                                                   FontWeight="SemiBold"
                                                   Foreground="{StaticResource TextPrimaryBrush}"
                                                   TextTrimming="CharacterEllipsis"/>
                                        <TextBlock FontSize="11"
                                                   Style="{StaticResource DataMuted}"
                                                   Margin="0,2,0,0">
                                            <Run Text="ELEV "/>
                                            <Run Text="{Binding ElevationFt,Mode=OneWay, StringFormat={}{0:F2} ft}"/>
                                        </TextBlock>
                                    </StackPanel>

                                    <Border Grid.Column="2"
                                            VerticalAlignment="Center"
                                            Background="{StaticResource BackgroundOverlayBrush}"
                                            CornerRadius="3"
                                            Padding="7,3">
                                        <TextBlock FontSize="11.5"
                                                   Style="{StaticResource DataMuted}">
                                            <Run Text="{Binding SelectedRoomCount, Mode=OneWay}"/>
                                            <Run Text="/"/>
                                            <Run Text="{Binding TotalRoomCount, Mode=OneWay}"/>
                                        </TextBlock>
                                    </Border>
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>

                    <Border Grid.Row="4"
                            BorderBrush="{StaticResource DividerBrush}"
                            BorderThickness="0,1,0,0"
                            Padding="0,10,0,0"
                            Margin="0,10,0,0">
                        <TextBlock Text="{Binding SelectedLevelSummary}"
                                   FontSize="11.5"
                                   Style="{StaticResource DataMuted}"/>
                    </Border>
                </Grid>
            </Border>

            <!-- ================= RIGHT: ROOMS ================= -->
            <Border Grid.Row="0" Grid.Column="2"
                    Style="{StaticResource CardBorder}">

                <Grid Margin="18,14">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0" VerticalAlignment="Center">
                            <TextBlock Text="{Binding RoomsHeader}"
                                       FontSize="17"
                                       FontWeight="SemiBold"
                                       Foreground="{StaticResource TextPrimaryBrush}"/>
                            <TextBlock Text="{Binding RoomsFoundText}"
                                       FontSize="11.5"
                                       Style="{StaticResource DataMuted}"
                                       Margin="0,3,0,0"/>
                        </StackPanel>

                        <ctrl:SearchBox Grid.Column="1"
                                        Width="300" Margin="12,0"
                                        Text="{Binding RoomSearchText, UpdateSourceTrigger=PropertyChanged}"
                                        Placeholder="Search rooms by name or number..."/>

                        <Button Grid.Column="2"
                                Style="{StaticResource OutlineButtonStyle}"
                                Command="{Binding ToggleHideUnselectedRoomsCommand}"
                                Padding="10,5">
                            <TextBlock FontSize="11.5" VerticalAlignment="Center">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Text" Value="Hide unselected"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding HideUnselectedRooms}" Value="True">
                                                <Setter Property="Text" Value="Show all"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </Button>
                    </Grid>

                    <Grid Grid.Row="1" Margin="0,12,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <CheckBox Grid.Column="0"
                                  Content="Eligible rooms only"
                                  IsChecked="{Binding ShowEligibleRoomsOnly, Mode=TwoWay}"
                                  VerticalAlignment="Center"
                                  Foreground="{StaticResource TextSecondaryBrush}"
                                  FontSize="12"
                                  Margin="0,0,16,0"/>

                        <Button Grid.Column="1"
                                Style="{StaticResource OutlineButtonStyle}"
                                Content="{Binding RoomSelectionToggleLabel}"
                                Command="{Binding ToggleSelectAllRoomsCommand}"
                                HorizontalAlignment="Right"/>
                    </Grid>

                    <!-- Column headers -->
                    <Border Grid.Row="2"
                            Background="{StaticResource BackgroundOverlayBrush}"
                            BorderBrush="{StaticResource DividerBrush}"
                            BorderThickness="0,1,0,1"
                            Padding="10,7"
                            Margin="0,12,0,0"
                            CornerRadius="3">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="36"/>
                                <ColumnDefinition Width="2.0*"/>
                                <ColumnDefinition Width="1.1*"/>
                                <ColumnDefinition Width="1.6*"/>
                                <ColumnDefinition Width="1.1*"/>
                            </Grid.ColumnDefinitions>

                            <CheckBox Grid.Column="0" IsEnabled="False"/>
                            <TextBlock Grid.Column="1" Text="ROOM NAME" Style="{StaticResource EyebrowText}"/>
                            <TextBlock Grid.Column="2" Text="AREA (SQ FT)" Style="{StaticResource EyebrowText}"/>
                            <TextBlock Grid.Column="3" Text="HAZARD CLASS" Style="{StaticResource EyebrowText}"/>
                            <TextBlock Grid.Column="4" Text="CEILING (FT)" Style="{StaticResource EyebrowText}"/>
                        </Grid>
                    </Border>

                    <ScrollViewer Grid.Row="3" VerticalScrollBarVisibility="Auto">
                        <ItemsControl ItemsSource="{Binding RoomsView}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border BorderBrush="{StaticResource DividerBrush}"
                                            BorderThickness="0,0,0,1"
                                            Padding="10,10">
                                        <Border.Style>
                                            <Style TargetType="Border">
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsEligible}" Value="False">
                                                        <Setter Property="Opacity" Value="0.5"/>
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding IsUndetermined}" Value="True">
                                                        <Setter Property="BorderBrush" Value="{StaticResource UndeterminedBrush}"/>
                                                        <Setter Property="BorderThickness" Value="3,0,0,1"/>
                                                        <Setter Property="Padding" Value="7,10,10,10"/>
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding IsBlocked}" Value="True">
                                                        <Setter Property="BorderBrush" Value="{StaticResource BlockedBrush}"/>
                                                        <Setter Property="BorderThickness" Value="3,0,0,1"/>
                                                        <Setter Property="Padding" Value="7,10,10,10"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Border.Style>
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="36"/>
                                                <ColumnDefinition Width="2.0*"/>
                                                <ColumnDefinition Width="1.1*"/>
                                                <ColumnDefinition Width="1.6*"/>
                                                <ColumnDefinition Width="1.1*"/>
                                            </Grid.ColumnDefinitions>

                                            <CheckBox Grid.Column="0"
                                                      IsChecked="{Binding IsSelected, Mode=TwoWay}"
                                                      IsEnabled="{Binding IsEligible}"
                                                      VerticalAlignment="Center"
                                                      ToolTip="{Binding EligibilityReason}"/>

                                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                <TextBlock Text="{Binding Name}"
                                                           FontSize="13"
                                                           FontWeight="SemiBold"
                                                           Foreground="{StaticResource TextPrimaryBrush}"
                                                           TextTrimming="CharacterEllipsis"/>
                                                <TextBlock FontSize="10.5"
                                                           Margin="0,3,0,0"
                                                           TextTrimming="CharacterEllipsis">
                                                    <TextBlock.Style>
                                                        <Style TargetType="TextBlock" BasedOn="{StaticResource DataMuted}">
                                                            <Setter Property="Visibility" Value="Collapsed"/>
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding IsEligible}" Value="False">
                                                                    <Setter Property="Visibility" Value="Visible"/>
                                                                </DataTrigger>
                                                                <DataTrigger Binding="{Binding IsBlocked}" Value="True">
                                                                    <Setter Property="Foreground" Value="{StaticResource BlockedOnDarkBrush}"/>
                                                                </DataTrigger>
                                                                <DataTrigger Binding="{Binding IsUndetermined}" Value="True">
                                                                    <Setter Property="Foreground" Value="{StaticResource UndeterminedOnDarkBrush}"/>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </TextBlock.Style>
                                                    <Run Text="{Binding EligibilityState, Mode=OneWay}"
                                                         FontWeight="Bold"/>
                                                    <Run Text=" &#x2014; "/>
                                                    <Run Text="{Binding EligibilityReason, Mode=OneWay}"/>
                                                </TextBlock>
                                            </StackPanel>

                                            <TextBlock Grid.Column="2"
                                                       Text="{Binding AreaSqFt, StringFormat={}{0:N2}}"
                                                       FontSize="12.5"
                                                       FontFamily="{StaticResource DataFontFamily}"
                                                       Foreground="{StaticResource TextPrimaryBrush}"
                                                       VerticalAlignment="Center"/>

                                            <StackPanel Grid.Column="3" VerticalAlignment="Center">
                                                <ComboBox Style="{StaticResource HazardComboBoxStyle}"
                                                          ItemsSource="{Binding HazardClassOptionsList}"
                                                          SelectedItem="{Binding SelectedHazardClass, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>

                                                <TextBlock FontSize="10.5"
                                                           Style="{StaticResource DataMuted}"
                                                           Margin="0,4,0,0">
                                                    <Run Text="Suggested: "/>
                                                    <Run Text="{Binding HazardClassSuggested, Mode=OneWay}"/>
                                                </TextBlock>

                                                <TextBlock Text="{Binding MatchedDisplay}"
                                                           FontSize="10.5"
                                                           Style="{StaticResource DataMuted}"
                                                           Margin="0,2,0,0"/>
                                            </StackPanel>

                                            <TextBlock Grid.Column="4"
                                                       Text="{Binding CeilingHeightFt, StringFormat={}{0:F2}}"
                                                       FontSize="12.5"
                                                       FontFamily="{StaticResource DataFontFamily}"
                                                       Foreground="{StaticResource TextPrimaryBrush}"
                                                       VerticalAlignment="Center"/>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>

                    <Border Grid.Row="4"
                            BorderBrush="{StaticResource DividerBrush}"
                            BorderThickness="0,1,0,0"
                            Padding="0,10,0,0"
                            Margin="0,10,0,0">
                        <TextBlock Text="{Binding RoomsSelectedSummary}"
                                   FontSize="11.5"
                                   Style="{StaticResource DataMuted}"/>
                    </Border>
                </Grid>
            </Border>
        </Grid>

        <!-- ================= BOTTOM ACTIONS ================= -->
        <Grid Grid.Row="3" Margin="0,16,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <ctrl:InfoBanner Grid.Column="0">
                <StackPanel>
                    <TextBlock Text="Hazard class is a suggestion based on room name and contents."
                               FontSize="11.5"
                               Style="{StaticResource DataMuted}"/>
                    <TextBlock Text="Review and adjust each room's hazard class before placement."
                               FontSize="11.5"
                               Style="{StaticResource DataMuted}"
                               Margin="0,2,0,0"/>
                </StackPanel>
            </ctrl:InfoBanner>

            <Button Grid.Column="1"
                    Style="{StaticResource PrimaryButtonStyle}"
                    Command="{Binding PlaceSprinklersCommand}"
                    Margin="16,0,0,0">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="&#x2295;" FontSize="14" Margin="0,0,8,0" VerticalAlignment="Center"/>
                    <TextBlock Text="Place Sprinklers" VerticalAlignment="Center"/>
                </StackPanel>
            </Button>

            <Button Grid.Column="2"
                    Style="{StaticResource OutlineButtonStyle}"
                    Command="{Binding ResetCommand}"
                    Margin="10,0,0,0"
                    Padding="18,9">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="&#x21BB;" FontSize="13" Margin="0,0,8,0" VerticalAlignment="Center"/>
                    <TextBlock Text="Reset" VerticalAlignment="Center"/>
                </StackPanel>
            </Button>
        </Grid>
    </Grid>

</UserControl>