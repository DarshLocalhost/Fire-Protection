              "properties": { "x": { "type": "number" }, "y": { "type": "number" }, "z": { "type": "number" } },
              "required": ["x", "y", "z"]
            },
            "level_id": { "type": "string" },
            "level_name": { "type": "string" },
            "host_id": { "type": "string" },
            "host_name": { "type": "string" }
          },
          "required": ["element_id", "room_id", "room_name", "family_name", "type_name", "location", "level_id", "level_name", "host_id", "host_name"]
        }
      },
      "obstacles": {
        "type": "array",
        "items": {
          "type": "object",
          "properties": {
            "element_id": { "type": "string" },
            "category": { "type": "string" },
            "name": { "type": "string" },
            "bounding_box": {
              "type": "object",
              "properties": {
                "min": { "type": "object", "properties": { "x": { "type": "number" }, "y": { "type": "number" }, "z": { "type": "number" } }, "required": ["x", "y", "z"] },
                "max": { "type": "object", "properties": { "x": { "type": "number" }, "y": { "type": "number" }, "z": { "type": "number" } }, "required": ["x", "y", "z"] }
              },
              "required": ["min", "max"]
            },
            "associated_room_ids": { "type": "array", "items": { "type": "string" } }
          },
          "required": ["element_id", "category", "name", "bounding_box", "associated_room_ids"]
        }
      },
      "summary": {
        "type": "object",
        "properties": {
          "total_rooms": { "type": "integer" },
          "total_ceilings": { "type": "integer" },
          "total_obstacles": { "type": "integer" },
          "total_existing_sprinklers": { "type": "integer" },
          "total_linked_documents": { "type": "integer" },
          "rooms_with_ceilings": { "type": "integer" },
          "rooms_without_ceilings": { "type": "integer" },
          "hazard_classification_counts": { "type": "object", "additionalProperties": { "type": "integer" } },
          "extraction_duration_ms": { "type": "integer" }
        },
        "required": ["total_rooms", "total_ceilings", "total_obstacles", "total_existing_sprinklers", "total_linked_documents", "rooms_with_ceilings", "rooms_without_ceilings", "hazard_classification_counts", "extraction_duration_ms"]
      },
      "warnings": {
        "type": "array",
        "items": {
          "type": "object",
          "properties": {
            "severity": { "type": "string" },
            "category": { "type": "string" },
            "message": { "type": "string" },
            "element_id": { "type": "string" },
            "element_name": { "type": "string" }
          },
          "required": ["severity", "category", "message"]
        }
      },
      "errors": {
        "type": "array",
        "items": {
          "type": "object",
          "properties": {
            "severity": { "type": "string" },
            "category": { "type": "string" },
            "message": { "type": "string" },
            "element_id": { "type": "string" },
            "element_name": { "type": "string" }
          },
          "required": ["severity", "category", "message"]
        }
      },
      "export_path": { "type": ["string", "null"] }
    },
    "required": ["schema_version", "units", "coordinate_system", "project", "model", "levels", "rooms", "ceilings", "existing_sprinklers", "obstacles", "summary", "warnings", "errors", "export_path"]
  },
  "input_examples": [
    { "export_file_path": "C:\\exports\\model_snapshot.json" },
    {}
  ],
  "annotations": {
    "readOnlyHint": true,
    "destructiveHint": false,
    "idempotentHint": true,
    "openWorldHint": false
  }
}