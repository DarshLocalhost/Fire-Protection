<Window x:Class="FireProtection.UI.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vmCatalog="clr-namespace:FireProtection.UI.ViewModels.Catalog"
        xmlns:vmNotif="clr-namespace:FireProtection.UI.ViewModels.NotificationAppliances"
        xmlns:vmSmoke="clr-namespace:FireProtection.UI.ViewModels.SmokeDetectors"
        xmlns:vmSprinklers="clr-namespace:FireProtection.UI.ViewModels.Sprinklers"
        xmlns:vCatalog="clr-namespace:FireProtection.UI.Views.Catalog"
        xmlns:vNotif="clr-namespace:FireProtection.UI.Views.NotificationAppliances"
        xmlns:vSmoke="clr-namespace:FireProtection.UI.Views.SmokeDetectors"
        xmlns:vSprinklers="clr-namespace:FireProtection.UI.Views.Sprinklers"
        xmlns:ctrl="clr-namespace:FireProtection.UI.Controls"
        Width="1180"
        Height="720"
        MinWidth="800"
        MinHeight="480"
        ResizeMode="CanResize"
        SizeToContent="Manual"
        Background="{DynamicResource BackgroundBrush}"
        FontFamily="Segoe UI"
        Title="Fire Protection System"
        WindowStartupLocation="CenterScreen"
        mc:Ignorable="d">
  <Window.Resources>
    <ResourceDictionary>
      <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="/FireProtection.UI;component/Themes/Colors.xaml"/>
        <ResourceDictionary Source="/FireProtection.UI;component/Themes/Styles.xaml"/>
      </ResourceDictionary.MergedDictionaries>

      <!-- ViewModel -> View mapping -->
      <DataTemplate DataType="{x:Type vmSprinklers:SprinklerViewModel}">
        <vSprinklers:SprinklerView />
      </DataTemplate>
      <DataTemplate DataType="{x:Type vmSmoke:SmokeDetectorViewModel}">
        <vSmoke:SmokeDetectorView />
      </DataTemplate>
      <DataTemplate DataType="{x:Type vmNotif:NotificationApplianceViewModel}">
        <vNotif:NotificationApplianceView />
      </DataTemplate>
    </ResourceDictionary>
  </Window.Resources>
  <Grid Background="{DynamicResource BackgroundBrush}">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>

    <!-- ================= HEADER ================= -->
    <Border Grid.Row="0"
            Background="{DynamicResource BackgroundBrush}"
            BorderBrush="{StaticResource BorderBrush}"
            BorderThickness="0"
            Padding="16,10,16,0">
      <DockPanel LastChildFill="False">
        <StackPanel Orientation="Horizontal" DockPanel.Dock="Left">
        <!-- Brand mark: sprinkler deflector plate -->
        <Border Width="32"
                Height="32"
                VerticalAlignment="Center"
                Background="{StaticResource BrandBrush}"
                CornerRadius="4">
          <Canvas Width="18" Height="18" HorizontalAlignment="Center" VerticalAlignment="Center">
            <!-- deflector -->
            <Rectangle Canvas.Left="3" Canvas.Top="4" Width="12" Height="2"
                       Fill="White" RadiusX="1" RadiusY="1"/>
            <!-- stem -->
            <Rectangle Canvas.Left="8" Canvas.Top="6" Width="2" Height="5.5"
                       Fill="White"/>
            <!-- drop -->
            <Path Data="M 9,12 C 11.2,14.8 11.2,16 9,16 C 6.8,16 6.8,14.8 9,12 Z"
                       Fill="White"/>
          </Canvas>
        </Border>
        <StackPanel Margin="10,0,0,0" VerticalAlignment="Center">
          <TextBlock FontSize="15"
                     FontWeight="SemiBold"
                     Foreground="{StaticResource TextPrimaryBrush}"
                     Text="Fire Protection System"/>
          <TextBlock Margin="0,1,0,0"
                     FontFamily="{StaticResource DataFontFamily}"
                     FontSize="9.5"
                     Foreground="{StaticResource TextMutedBrush}"
                     Text="AUTOMATED LAYOUT WITH CODE-BASED CALCULATIONS"/>
        </StackPanel>
        </StackPanel>

        <!-- Header action buttons -->
        <StackPanel Orientation="Horizontal" DockPanel.Dock="Right" VerticalAlignment="Center">
          <Button Content="&#x21BB; Refresh"
                  Style="{StaticResource OutlineButtonStyle}"
                  Padding="12,5"
                  Margin="0,0,8,0"
                  VerticalAlignment="Center"
                  Command="{Binding RefreshModelCommand}"
                  ToolTip="Re-extracts model data (levels, rooms, obstacles, existing devices) from the active Revit document and updates the view."/>

          <!-- Loads a picked .rfa into the active model. Shared across all three device tabs; the
               actual load is marshalled onto Revit's idle thread by the view model. -->
          <Button Content="Load families…"
                  Style="{StaticResource OutlineButtonStyle}"
                  Padding="12,5"
                  VerticalAlignment="Center"
                  Command="{Binding LoadFamiliesCommand}"
                  ToolTip="Load Revit families (.rfa) into the current model. Available for every device tab."/>
        </StackPanel>
      </DockPanel>
    </Border>

    <!-- Top-level tabs -->
    <TabControl Margin="0,0,0,0"
                HorizontalAlignment="Stretch"
                VerticalAlignment="Stretch"
                Background="{x:Null}"
                ItemContainerStyle="{StaticResource TopTabItemStyle}"
                Style="{StaticResource TopTabControlStyle}"
                Grid.Row="2">
          <TabItem Header="Sprinklers">
            <ContentControl Content="{Binding Sprinkler}" />
          </TabItem>
          <TabItem Header="Smoke Detectors">
            <ContentControl Content="{Binding SmokeDetector}" />
          </TabItem>
          <TabItem Header="Notification Appliances">
            <ContentControl Content="{Binding NotificationAppliance}" />
          </TabItem>
        </TabControl>

    <!-- Catalog top bar (Decision 020) -->
    <vCatalog:CatalogBar Grid.Row="1"
                         Margin="12,0,12,0"
                         DataContext="{Binding Catalog}"/>

    <!-- Source-status banner. Hosted ONCE here rather than per tab, because the catalog source is
         a single shared decision. It exists so a missing per-type engineering value is never
         silent: in model mode without a workbook the calculation falls back to provisional
         rulebook spacing, and without this the user cannot tell that happened. -->
    <ctrl:InfoBanner Grid.Row="2"
                     Margin="12,0,12,0"
                     Content="{Binding Catalog.StatusMessage}"
                     DataContext="{Binding Catalog}"
                     Visibility="{Binding HasStatusMessage, Converter={StaticResource InverseBoolToVis}}"/>
  </Grid>
</Window>
