<UserControl x:Class="FireProtection.UI.Controls.InfoBanner"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Name="Root">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/FireProtection.UI;component/Themes/Colors.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>

    <Border Background="{StaticResource BackgroundOverlayBrush}"
            BorderBrush="{StaticResource DividerBrush}"
            BorderThickness="1"
            CornerRadius="4"
            Padding="14,9"
            VerticalAlignment="Center">
        <StackPanel Orientation="Horizontal">
            <Ellipse Width="7" Height="7"
                     Fill="{StaticResource BrassBrush}"
                     Margin="0,1,10,0"
                     VerticalAlignment="Top"/>
            <ContentPresenter Content="{Binding Content, ElementName=Root}"
                              ContentTemplate="{Binding ContentTemplate, ElementName=Root}"/>
        </StackPanel>
    </Border>

</UserControl>