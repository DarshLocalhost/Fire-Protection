<UserControl x:Class="FireProtection.UI.Views.SmokeDetectors.SmokeDetectorView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:vDevices="clr-namespace:FireProtection.UI.Views.Devices"
             mc:Ignorable="d"
             d:DesignHeight="820" d:DesignWidth="1280">

    <UserControl.Resources>
        <Style x:Key="DeviceParamCombo" TargetType="ComboBox">
            <Setter Property="Padding" Value="10,6"/>
            <Setter Property="MinHeight" Value="34"/>
            <Setter Property="BorderBrush" Value="#E2E8F0"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Background" Value="White"/>
            <Setter Property="Foreground" Value="#0F172A"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Style.Triggers>
                <Trigger Property="IsKeyboardFocusWithin" Value="True">
                    <Setter Property="BorderBrush" Value="#2563EB"/>
                </Trigger>
            </Style.Triggers>
        </Style>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="12"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Device-specific parameter card (NFPA-72) -->
        <Border Grid.Row="0"
                Background="White"
                BorderBrush="#E2E8F0"
                BorderThickness="1"
                CornerRadius="8"
                Padding="18">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="120"/>
                    <ColumnDefinition Width="200"/>
                    <ColumnDefinition Width="24"/>
                    <ColumnDefinition Width="120"/>
                    <ColumnDefinition Width="200"/>
                    <ColumnDefinition Width="24"/>
                    <ColumnDefinition Width="120"/>
                    <ColumnDefinition Width="200"/>
                </Grid.ColumnDefinitions>

                <TextBlock Grid.Column="0" Text="Detector Type" FontSize="13" FontWeight="SemiBold"
                           Foreground="#0F172A" VerticalAlignment="Center"/>
                <ComboBox Grid.Column="1" ItemsSource="{Binding DetectorTypeOptions}"
                          SelectedItem="{Binding DetectorType, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                          Style="{StaticResource DeviceParamCombo}"/>

                <TextBlock Grid.Column="3" Text="Mount" FontSize="13" FontWeight="SemiBold"
                           Foreground="#0F172A" VerticalAlignment="Center"/>
                <ComboBox Grid.Column="4" ItemsSource="{Binding CeilingMountOptions}"
                          SelectedItem="{Binding CeilingMount, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                          Style="{StaticResource DeviceParamCombo}"/>

                <TextBlock Grid.Column="6" Text="Ceiling Slope" FontSize="13" FontWeight="SemiBold"
                           Foreground="#0F172A" VerticalAlignment="Center"/>
                <ComboBox Grid.Column="7" ItemsSource="{Binding CeilingSlopeOptions}"
                          SelectedItem="{Binding CeilingSlope, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                          Style="{StaticResource DeviceParamCombo}"/>
            </Grid>
        </Border>

        <!-- Shared device placement workflow -->
        <vDevices:DevicePlacementView Grid.Row="2"/>
    </Grid>
</UserControl>
