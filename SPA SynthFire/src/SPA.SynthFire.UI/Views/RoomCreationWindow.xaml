<Window x:Class="SPA.SynthFire.UI.Views.RoomCreationWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="SPA SynthFire — Room Creation"
        Width="420" Height="470"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize"
        Background="{DynamicResource Surface}"
        Foreground="{DynamicResource Ink}"
        FontFamily="Segoe UI" FontSize="13"
        ShowInTaskbar="False">
    <Window.Resources>
        <ResourceDictionary Source="/SPA.SynthFire.UI;component/Themes/Styles.xaml"/>
    </Window.Resources>
    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="Room Creation" Style="{StaticResource SectionHeader}"/>
        <TextBlock Grid.Row="1" Margin="0,4,0,14" Foreground="{StaticResource Muted}" TextWrapping="Wrap"
                   Text="Automatically create rooms in every enclosed region on the selected levels. Revit stays editable while this window is open."/>

        <TextBlock Grid.Row="2" Text="Levels (select one or more)" Style="{StaticResource FieldLabel}"/>
        <ListBox Grid.Row="3" x:Name="LevelList" SelectionMode="Extended"
                 DisplayMemberPath="Label" BorderBrush="{StaticResource Line}"/>

        <Border Grid.Row="4" Style="{StaticResource Card}" Margin="0,14,0,0">
            <TextBlock x:Name="StatusText" TextWrapping="Wrap" Foreground="{StaticResource Muted}" Text="Ready."/>
        </Border>

        <StackPanel Grid.Row="5" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,14,0,0">
            <Button x:Name="CreateButton" Content="Create rooms" Width="140" Margin="0,0,8,0"
                    Click="Create_Click" Style="{StaticResource PrimaryButton}"/>
            <Button Content="Close" Width="90" Click="Close_Click" Style="{StaticResource SecondaryButton}"/>
        </StackPanel>
    </Grid>
</Window>
