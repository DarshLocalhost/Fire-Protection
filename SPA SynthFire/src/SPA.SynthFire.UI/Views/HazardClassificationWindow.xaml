<Window x:Class="SPA.SynthFire.UI.Views.HazardClassificationWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="SPA SynthFire — Hazard Classification"
        Width="760" Height="560"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource Surface}"
        Foreground="{DynamicResource Ink}"
        FontFamily="Segoe UI" FontSize="13"
        ShowInTaskbar="False">
    <Window.Resources>
        <ResourceDictionary Source="/SPA.SynthFire.UI;component/Themes/Styles.xaml"/>
    </Window.Resources>
    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="Hazard Classification" Style="{StaticResource SectionHeader}"/>
        <TextBlock Grid.Row="1" Margin="0,4,0,14" Foreground="{StaticResource Muted}" TextWrapping="Wrap"
                   Text="Each room is auto-classified from its name (rooms with no keyword match default to Light hazard). Change any room's hazard below, then Apply to write it to the room. Revit stays editable while this window is open."/>

        <TextBlock Grid.Row="2" Text="Design standard" Style="{StaticResource FieldLabel}"/>
        <ComboBox Grid.Row="3" x:Name="StandardCombo" Margin="0,0,0,12" HorizontalAlignment="Left" Width="360"
                  DisplayMemberPath="DisplayName" SelectionChanged="StandardCombo_SelectionChanged"/>

        <DataGrid Grid.Row="4" x:Name="RoomGrid"
                  AutoGenerateColumns="False" CanUserAddRows="False" CanUserDeleteRows="False"
                  HeadersVisibility="Column" GridLinesVisibility="Horizontal"
                  IsReadOnly="False" SelectionMode="Extended" RowHeaderWidth="0">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Room" Binding="{Binding RoomName}" IsReadOnly="True" Width="2*"/>
                <DataGridTextColumn Header="Level" Binding="{Binding LevelName}" IsReadOnly="True" Width="*"/>
                <DataGridTextColumn Header="Suggested (auto)" Binding="{Binding SuggestedText}" IsReadOnly="True" Width="2*"/>
                <DataGridComboBoxColumn Header="Assigned hazard" Width="1.6*"
                                        SelectedItemBinding="{Binding Assigned}"
                                        DisplayMemberPath="DisplayName">
                    <DataGridComboBoxColumn.EditingElementStyle>
                        <Style TargetType="ComboBox">
                            <Setter Property="ItemsSource" Value="{Binding HazardOptions}"/>
                        </Style>
                    </DataGridComboBoxColumn.EditingElementStyle>
                    <DataGridComboBoxColumn.ElementStyle>
                        <Style TargetType="ComboBox">
                            <Setter Property="ItemsSource" Value="{Binding HazardOptions}"/>
                            <Setter Property="IsReadOnly" Value="True"/>
                            <Setter Property="Background" Value="Transparent"/>
                            <Setter Property="BorderThickness" Value="0"/>
                        </Style>
                    </DataGridComboBoxColumn.ElementStyle>
                </DataGridComboBoxColumn>
            </DataGrid.Columns>
        </DataGrid>

        <Border Grid.Row="5" Style="{StaticResource Card}" Margin="0,14,0,0">
            <TextBlock x:Name="StatusText" TextWrapping="Wrap" Foreground="{StaticResource Muted}" Text="Ready."/>
        </Border>

        <StackPanel Grid.Row="6" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,14,0,0">
            <Button x:Name="ResetButton" Content="Reset to suggested" Width="150" Margin="0,0,8,0"
                    Click="Reset_Click" Style="{StaticResource SecondaryButton}"/>
            <Button x:Name="ApplyButton" Content="Apply" Width="120" Margin="0,0,8,0"
                    Click="Apply_Click" Style="{StaticResource PrimaryButton}"/>
            <Button Content="Close" Width="90" Click="Close_Click" Style="{StaticResource SecondaryButton}"/>
        </StackPanel>
    </Grid>
</Window>
