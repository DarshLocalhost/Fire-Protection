<Window x:Class="FireProtection.UI.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vmNotif="clr-namespace:FireProtection.UI.ViewModels.NotificationAppliances"
        xmlns:vmSmoke="clr-namespace:FireProtection.UI.ViewModels.SmokeDetectors"
        xmlns:vmSprinklers="clr-namespace:FireProtection.UI.ViewModels.Sprinklers"
        xmlns:vNotif="clr-namespace:FireProtection.UI.Views.NotificationAppliances"
        xmlns:vSmoke="clr-namespace:FireProtection.UI.Views.SmokeDetectors"
        xmlns:vSprinklers="clr-namespace:FireProtection.UI.Views.Sprinklers"
        Width="1400"
        Height="900"
        Background="White"
        FontFamily="Segoe UI"
        Title="Fire Protection System"
        WindowStartupLocation="CenterScreen"
        mc:Ignorable="d">
  <Window.Resources>
    <!-- Colors -->
    <SolidColorBrush x:Key="AccentBrush" Color="#2563EB" />
    <SolidColorBrush x:Key="TextPrimaryBrush" Color="#0F172A" />
    <SolidColorBrush x:Key="TextSecondaryBrush" Color="#64748B" />
    <SolidColorBrush x:Key="BorderBrush" Color="#E2E8F0" />
    <SolidColorBrush x:Key="SurfaceBrush" Color="#FFFFFF" />
    <SolidColorBrush x:Key="SubtleBrush" Color="#F8FAFC" />
    <!-- Top-level tab item style -->
    <Style x:Key="TopTabItemStyle" TargetType="TabItem">
      <Setter Property="Foreground"
              Value="{StaticResource TextSecondaryBrush}" />
      <Setter Property="FontSize" Value="15" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="Padding" Value="32,14" />
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderBrush" Value="Transparent" />
      <Setter Property="HorizontalContentAlignment" Value="Center" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="TabItem">
            <Grid>
              <Border x:Name="Bd"
                      Background="{TemplateBinding Background}"
                      Padding="{TemplateBinding Padding}">
                <ContentPresenter x:Name="ContentSite"
                                  HorizontalAlignment="Center"
                                  VerticalAlignment="Center"
                                  ContentSource="Header"
                                  RecognizesAccessKey="True" />
              </Border>
              <Border x:Name="Underline"
                      Height="3"
                      VerticalAlignment="Bottom"
                      Background="{StaticResource AccentBrush}"
                      Visibility="Collapsed" />
            </Grid>
            <ControlTemplate.Triggers>
              <Trigger Property="IsSelected" Value="True">
                <Setter Property="Visibility"
                        TargetName="Underline"
                        Value="Visible" />
                <Setter Property="Foreground"
                        Value="{StaticResource AccentBrush}" />
              </Trigger>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Foreground"
                        Value="{StaticResource AccentBrush}" />
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <!-- Top-level TabControl style -->
    <Style x:Key="TopTabControlStyle" TargetType="TabControl">
      <Setter Property="Background"
              Value="{StaticResource SurfaceBrush}" />
      <Setter Property="BorderBrush"
              Value="{StaticResource BorderBrush}" />
      <Setter Property="BorderThickness" Value="0,0,0,1" />
      <Setter Property="Padding" Value="0" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="TabControl">
            <Grid>
              <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
              </Grid.RowDefinitions>
              <Border Background="{TemplateBinding Background}"
                      BorderBrush="{TemplateBinding BorderBrush}"
                      BorderThickness="{TemplateBinding BorderThickness}"
                      Grid.Row="0">
                <TabPanel x:Name="HeaderPanel"
                          HorizontalAlignment="Center"
                          Background="Transparent"
                          IsItemsHost="True" />
              </Border>
              <Border Background="{StaticResource SubtleBrush}" Grid.Row="1">
                <ContentPresenter ContentSource="SelectedContent" />
              </Border>
            </Grid>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <!-- ViewModel -> View mapping -->
    <DataTemplate DataType="{x:Type vmSprinklers:SprinklerViewModel}">
      <vSprinklers:SprinklerView />
    </DataTemplate>
    <DataTemplate DataType="{x:Type vmSmoke:SmokeDetectorViewModel}">
      <vSmoke:SmokeDetectorView />
    </DataTemplate>
    <DataTemplate DataType="{x:Type vmNotif:NotificationApplianceViewModel}">
      <vNotif:NotificationApplianceView />
    </DataTemplate>
  </Window.Resources>
  <Grid Background="{StaticResource SurfaceBrush}">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
    </Grid.RowDefinitions>
    <!-- Header -->
    <Border Background="{StaticResource SurfaceBrush}"
            BorderBrush="{StaticResource BorderBrush}"
            BorderThickness="0,0,0,0"
            Padding="24,20"
            Grid.Row="0">
      <StackPanel Orientation="Horizontal">
        <Border Width="44"
                Height="44"
                VerticalAlignment="Center"
                Background="{StaticResource AccentBrush}"
                CornerRadius="8">
          <TextBlock HorizontalAlignment="Center"
                     VerticalAlignment="Center"
                     FontSize="22"
                     Foreground="White"
                     RenderTransformOrigin="0.5,0.5"
                     Text="🛡" />
        </Border>
        <StackPanel Margin="14,0,0,0" VerticalAlignment="Center">
          <TextBlock FontSize="20"
                     FontWeight="SemiBold"
                     Foreground="{StaticResource TextPrimaryBrush}"
                     Text="Fire Protection System" />
          <TextBlock Margin="0,2,0,0"
                     FontSize="13"
                     Foreground="{StaticResource TextSecondaryBrush}"
                     Text="Automated fire protection layout with code-based calculations" />
        </StackPanel>
      </StackPanel>
    </Border>
    <!-- Top-level Tabs -->
    <TabControl Margin="4,0,-4,0"
                HorizontalAlignment="Stretch"
                VerticalAlignment="Stretch"
                Background="{x:Null}"
                ItemContainerStyle="{StaticResource TopTabItemStyle}"
                Style="{StaticResource TopTabControlStyle}"
                Grid.Column="0"
                Grid.Row="1">
      <TabItem Header="Sprinklers">
        <ContentControl Content="{Binding Sprinkler}" />
      </TabItem>
      <TabItem Header="Smoke Detectors">
        <ContentControl Content="{Binding SmokeDetector}" />
      </TabItem>
      <TabItem Header="Notification Appliances">
        <ContentControl Content="{Binding NotificationAppliance}" />
      </TabItem>
      <DockPanel Width="120" Height="100" Background="#FFA87272" />
      <ListBox Width="120" Height="100" />
    </TabControl>
  </Grid>
</Window>