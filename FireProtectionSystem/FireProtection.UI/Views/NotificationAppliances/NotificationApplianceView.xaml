<UserControl x:Class="FireProtection.UI.Views.NotificationAppliances.NotificationApplianceView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:vDevices="clr-namespace:FireProtection.UI.Views.Devices"
             mc:Ignorable="d"
             d:DesignHeight="820" d:DesignWidth="1280">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/FireProtection.UI;component/Themes/Colors.xaml"/>
                <ResourceDictionary Source="/FireProtection.UI;component/Themes/Styles.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>

    <!-- 16px side inset matches the nested DevicePlacementView, so this card's edges line up with
         the cards below it. No bottom margin: row 1 is the 12px gutter. -->
    <Grid Margin="16,16,16,0">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="12"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Device-specific parameter card. Every list below is filled from the loaded Excel catalog. -->
        <Border Grid.Row="0"
                Background="{StaticResource SurfaceBrush}"
                BorderBrush="{StaticResource BorderBrush}"
                BorderThickness="1"
                CornerRadius="6"
                Padding="18">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- One run of label/field pairs: each caption sits 10px from its own control, 36px
                     separates one pair from the next. WrapPanel so a narrow window wraps whole pairs
                     onto the next line instead of clipping the last combo. Fixed label columns used to
                     strand the caption an inch away from the combo it belongs to. -->
                <WrapPanel Grid.Row="0">
                    <StackPanel Orientation="Horizontal" Margin="0,0,36,6">
                        <TextBlock Text="Appliance Type" Style="{StaticResource FieldLabel}"/>
                        <ComboBox Width="220" ItemsSource="{Binding ApplianceTypeOptions}"
                                  SelectedItem="{Binding ApplianceType, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                  Style="{StaticResource StandardComboBoxStyle}"/>
                    </StackPanel>

                    <StackPanel Orientation="Horizontal" Margin="0,0,36,6">
                        <TextBlock Text="Candela" Style="{StaticResource FieldLabel}"/>
                        <ComboBox Width="220" ItemsSource="{Binding CandelaOptions}"
                                  SelectedItem="{Binding Candela, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                  Style="{StaticResource StandardComboBoxStyle}"/>
                    </StackPanel>

                    <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                        <TextBlock Text="Notification dBA" Style="{StaticResource FieldLabel}"/>
                        <ComboBox Width="220" ItemsSource="{Binding NotificationDbaOptions}"
                                  SelectedItem="{Binding NotificationDba, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                  Style="{StaticResource StandardComboBoxStyle}"/>
                    </StackPanel>
                </WrapPanel>

                <TextBlock Grid.Row="1"
                           Margin="0,10,0,0"
                           FontSize="12"
                           TextWrapping="Wrap"
                           Foreground="{StaticResource UndeterminedBrush}"
                           Text="{Binding CatalogStatusMessage}">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Setter Property="Visibility" Value="Collapsed"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsCatalogLoaded}" Value="False">
                                    <Setter Property="Visibility" Value="Visible"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
            </Grid>
        </Border>

        <!-- Shared device placement workflow -->
        <vDevices:DevicePlacementView Grid.Row="2"/>
    </Grid>
</UserControl>
